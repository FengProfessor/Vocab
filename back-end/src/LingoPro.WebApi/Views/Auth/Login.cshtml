@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/app";
    var mode = ViewData["Mode"] as string ?? "login";
    var isSignup = string.Equals(mode, "signup", StringComparison.OrdinalIgnoreCase);
    var role = ViewData["Role"] as string ?? "student";
    var isTeacher = string.Equals(role, "teacher", StringComparison.OrdinalIgnoreCase);
    var errorMessage = ViewData["ErrorMessage"] as string;
    var statusMessage = ViewData["StatusMessage"] as string;
    var emailValue = ViewData["Email"] as string ?? "";
    var fullNameValue = ViewData["FullName"] as string ?? "";
    var referralCode = ViewData["ReferralCode"] as string ?? "";
    var hasReferralGift = ViewData["HasReferralGift"] is true;
    var isInApp = ViewData["IsInApp"] is true;
    var inAppName = ViewData["InAppName"] as string ?? "app";
    var isAndroid = ViewData["IsAndroid"] is true;
    var authUrl = ViewData["AuthUrl"] as string ?? "https://lingopro.online/auth";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="theme-color" content="#6366f1" />
    <title>@(isSignup ? "Đăng Ký — LingoPro" : "Đăng Nhập — LingoPro")</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.ico?v=parrot1" sizes="any" />
    <link rel="icon" href="/icon-192.png?v=parrot1" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=parrot1" sizes="180x180" />

    <!-- Google Fonts: Inter & Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS v4 Browser Runtime -->
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>

    <style>
        :root {
            --font-inter: 'Inter', 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html, body {
            margin: 0;
            min-height: 100dvh;
            background-color: #f6efe6;
            color: #241710;
            font-family: var(--font-inter);
            -webkit-font-smoothing: antialiased;
        }
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }
        @@keyframes spinIcon {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-icon { animation: spinIcon 1s linear infinite; }
        @@keyframes pulseSlow {
            0%, 100% { opacity: 1; }
            50% { opacity: .5; }
        }
        .animate-pulse-icon { animation: pulseSlow 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    </style>
</head>
<body
    class="min-h-dvh overflow-x-hidden bg-[#f6efe6] text-[#241710] antialiased"
    style="padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom);"
>
    <!-- Ambient Background Glows matching src/app/auth/page.tsx -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute left-[-20%] top-[-12%] h-56 w-56 rounded-full bg-[#e57b52]/18 blur-3xl sm:left-[-8%] sm:h-[24rem] sm:w-[24rem]"></div>
        <div class="absolute right-[-18%] top-[12%] h-52 w-52 rounded-full bg-[#d2c09e]/30 blur-3xl sm:right-[-8%] sm:h-[26rem] sm:w-[26rem]"></div>
        <div class="absolute bottom-[-12%] left-1/3 hidden h-[20rem] w-[20rem] rounded-full bg-[#f1c46d]/15 blur-3xl sm:block"></div>
    </div>

    <div class="relative mx-auto grid min-h-dvh w-full max-w-6xl lg:grid-cols-[1.05fr_0.95fr]">
        <!-- Desktop brand panel (Left Column) -->
        <aside class="relative hidden flex-col justify-between p-8 lg:flex lg:p-12">
            <a href="/" class="inline-flex items-center gap-2.5 text-[#241710]">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#241710] text-[#f6efe6]">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg>
                </div>
                <span class="text-xl font-bold tracking-tight">LingoPro</span>
            </a>

            <div class="space-y-6">
                <div class="inline-flex items-center gap-2 rounded-full border border-[#b86f52]/20 bg-white/80 px-3.5 py-1 text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#9f4d2f]">
                    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
                    App học từ vựng · FSRS
                </div>

                <h1 class="max-w-md text-4xl font-bold leading-[1.1] tracking-[-0.03em] xl:text-[2.75rem]">
                    Học từ vựng —
                    <span class="text-[#b5502f]">tra 1 chạm, nhớ lâu hơn</span>
                </h1>

                <p class="max-w-sm text-base leading-7 text-[#5e4b40]">
                    Tra từ trên web → lưu kho riêng → ôn đúng lúc bằng FSRS.
                    Chặng ngắn 5–8 phút, lộ trình sẵn cho người Việt.
                </p>

                <ul class="space-y-3">
                    <li class="flex items-center gap-3 rounded-2xl border border-[#bca58f]/35 bg-white/70 px-4 py-3 shadow-sm">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#241710] text-[#f6efe6]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" x2="12" y1="8" y2="8"/><line x1="3.95" x2="8.54" y1="6.06" y2="14"/><line x1="10.88" x2="15.46" y1="21.94" y2="14"/></svg>
                        </div>
                        <span class="text-sm font-bold text-[#3d2c22]">Tra từ 1 chạm trên web</span>
                    </li>
                    <li class="flex items-center gap-3 rounded-2xl border border-[#bca58f]/35 bg-white/70 px-4 py-3 shadow-sm">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#241710] text-[#f6efe6]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
                        </div>
                        <span class="text-sm font-bold text-[#3d2c22]">Lưu kho riêng · ảnh + ví dụ</span>
                    </li>
                    <li class="flex items-center gap-3 rounded-2xl border border-[#bca58f]/35 bg-white/70 px-4 py-3 shadow-sm">
                        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#241710] text-[#f6efe6]">
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 3-3 3 3"/><path d="M13 18H7a2 2 0 0 1-2-2V6"/><path d="m22 15-3 3-3-3"/><path d="M11 6h6a2 2 0 0 1 2 2v10"/></svg>
                        </div>
                        <span class="text-sm font-bold text-[#3d2c22]">Ôn FSRS đúng lúc quên</span>
                    </li>
                </ul>

                <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-[#7b6558]">
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-[#2d7f5e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        Miễn phí bắt đầu
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-[#2d7f5e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        5–8 phút/chặng
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <svg class="h-3.5 w-3.5 text-[#2d7f5e]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        Lộ trình sẵn
                    </span>
                </div>
            </div>

            <p class="text-xs font-semibold text-[#a08b7c]">
                9.000+ từ · 660+ chặng · 30+ lộ trình
            </p>
        </aside>

        <!-- Form Column (Right Column) -->
        <div class="flex min-h-dvh w-full flex-col items-center justify-start px-3 pb-8 pt-3 sm:px-6 sm:pb-10 sm:pt-8 lg:justify-center lg:py-12">
            <!-- Mobile Brand Header -->
            <div class="mb-3 flex w-full max-w-md flex-col items-center sm:mb-5 lg:hidden">
                <a href="/" class="inline-flex items-center gap-2 text-[#241710]">
                    <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#241710] text-[#f6efe6]">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"/><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"/><path d="M3.477 10.896a4 4 0 0 1 .585-.396"/><path d="M19.938 10.5a4 4 0 0 1 .585.396"/><path d="M6 18a4 4 0 0 1-1.967-.516"/><path d="M19.967 17.484A4 4 0 0 1 18 18"/></svg>
                    </div>
                    <span class="text-lg font-bold tracking-tight sm:text-xl">LingoPro</span>
                </a>
                <p id="mobile-subtitle" class="mt-1.5 text-center text-xs font-semibold text-[#7b6558] sm:text-sm">
                    @(isSignup ? "Tạo tài khoản miễn phí" : "Chào mừng trở lại")
                </p>
            </div>

            <div class="w-full max-w-md">
                <div class="rounded-2xl border border-[#241710]/10 bg-[#241710] p-4 text-[#f6efe6] shadow-[0_20px_50px_rgba(36,23,16,0.2)] sm:rounded-[1.75rem] sm:p-6 lg:p-8">
                    <!-- Desktop Card Header -->
                    <div class="mb-5 hidden lg:block">
                        <p id="desktop-title" class="text-2xl font-bold tracking-tight">
                            @(isSignup ? "Tạo tài khoản" : "Đăng nhập")
                        </p>
                        <p id="desktop-subtitle" class="mt-1.5 text-sm text-[#d8c9bc]">
                            @(isSignup ? "Bắt đầu miễn phí — không cần thẻ." : "Tiếp tục lộ trình từ vựng của bạn.")
                        </p>
                    </div>

                    <!-- Referral Gift Banner -->
                    <div id="referral-gift-banner" style="@(hasReferralGift ? "" : "display:none")" class="mb-4 flex items-center gap-2.5 rounded-2xl border border-amber-400/40 bg-amber-500/15 p-3 text-xs font-semibold text-amber-100 shadow-xs">
                        <svg class="animate-pulse-icon h-5 w-5 shrink-0 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>
                        <div class="leading-relaxed">
                            <span id="referral-gift-signup-text" style="@(isSignup ? "" : "display:none")">
                                <span class="font-bold text-white">Quà tặng bạn mới:</span> Đăng ký ngay để nhận <span class="font-bold text-amber-300">7 ngày Pro VIP</span> học tập cùng bạn bè!
                            </span>
                            <span id="referral-gift-login-text" style="@(isSignup ? "display:none" : "")">
                                <span class="font-bold text-white">Quà tặng bạn bè:</span> Đăng nhập để kích hoạt hoặc chuyển sang tab
                                <button type="button" id="referral-switch-signup" class="cursor-pointer font-bold text-amber-300 underline hover:text-amber-200">
                                    Đăng ký
                                </button>
                                nếu bạn chưa có tài khoản!
                            </span>
                        </div>
                    </div>

                    <!-- Mode Switcher Tabs (Đăng nhập / Đăng ký) -->
                    <div class="mb-4 flex rounded-2xl border border-white/10 bg-white/[0.06] p-1 sm:mb-5">
                        <button
                            type="button"
                            id="tab-login"
                            class="min-h-11 flex-1 rounded-xl text-sm font-black transition-all sm:min-h-12 cursor-pointer @(!isSignup ? "bg-[#b5502f] text-white shadow-[0_8px_20px_rgba(181,80,47,0.35)]" : "text-[#cbb7a6] hover:text-[#f6efe6]")"
                        >
                            Đăng nhập
                        </button>
                        <button
                            type="button"
                            id="tab-signup"
                            class="min-h-11 flex-1 rounded-xl text-sm font-black transition-all sm:min-h-12 cursor-pointer @(isSignup ? "bg-[#b5502f] text-white shadow-[0_8px_20px_rgba(181,80,47,0.35)]" : "text-[#cbb7a6] hover:text-[#f6efe6]")"
                        >
                            Đăng ký
                        </button>
                    </div>

                    <!-- Error Alert Box -->
                    <div
                        id="auth-error-box"
                        role="alert"
                        style="@(!string.IsNullOrWhiteSpace(errorMessage) ? "" : "display:none")"
                        class="mb-4 flex items-start gap-2.5 rounded-2xl border border-rose-400/25 bg-rose-500/15 p-3 sm:mb-5 sm:p-4"
                    >
                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-rose-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                        <p id="auth-error-text" class="break-words text-xs font-semibold leading-relaxed text-rose-100">@errorMessage</p>
                    </div>

                    <form id="auth-form" method="post" action="/auth/login" class="space-y-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="input-return-url" name="ReturnUrl" value="@returnUrl" />
                        <input type="hidden" id="input-mode" name="Mode" value="@(isSignup ? "signup" : "login")" />
                        <input type="hidden" id="input-role" name="Role" value="@(isTeacher ? "teacher" : "student")" />
                        <input type="hidden" id="input-referral" name="ReferralCode" value="@referralCode" />
                        <input type="text" name="Website" value="" tabindex="-1" autocomplete="off" style="display:none" aria-hidden="true" />

                        <!-- WebView / Zalo / FB Warning Banner -->
                        <div
                            id="inapp-warning-box"
                            style="@(isInApp ? "" : "display:none")"
                            class="space-y-2.5 rounded-2xl border border-amber-400/40 bg-amber-500/15 p-3.5"
                        >
                            <p class="text-sm font-black text-amber-100">
                                ⚠️ Đang mở trong <span id="inapp-name-label">@inAppName</span>
                            </p>
                            <p class="text-xs font-semibold leading-relaxed text-amber-50/90">
                                Google <b>không cho</b> đăng nhập trong Zalo / Facebook / WebView.
                                Hãy mở <b>Chrome</b> hoặc <b>Safari</b>, vào:
                            </p>
                            <p class="break-all rounded-xl bg-black/25 px-3 py-2 font-mono text-[12px] font-bold text-white">
                                lingopro.online/auth
                            </p>
                            <div class="flex flex-col gap-2 sm:flex-row">
                                <button
                                    type="button"
                                    id="btn-open-external"
                                    class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-full bg-amber-400 px-3 text-sm font-black text-[#241710] active:scale-[0.98] cursor-pointer"
                                >
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                                    <span id="btn-open-external-label">@(isAndroid ? "Mở bằng Chrome" : "Copy link mở Safari")</span>
                                </button>
                                <button
                                    type="button"
                                    id="btn-copy-auth-url"
                                    data-auth-url="@authUrl"
                                    class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 text-sm font-bold text-white active:scale-[0.98] cursor-pointer"
                                >
                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                                    <span id="btn-copy-auth-label">Copy link</span>
                                </button>
                            </div>
                            <p class="text-[11px] font-semibold text-amber-50/80">
                                Hoặc đăng ký / đăng nhập bằng <b>email + mật khẩu</b> bên dưới (vẫn dùng được trong app).
                            </p>
                        </div>

                        <!-- Google Sign-In Button -->
                        <button
                            type="button"
                            id="google-signin-btn"
                            @(isInApp ? "disabled" : "")
                            class="inline-flex min-h-12 w-full items-center justify-center gap-2.5 rounded-full border border-white/15 bg-white text-sm font-bold text-[#241710] transition-all active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 cursor-pointer"
                        >
                            <svg id="google-icon-svg" viewBox="0 0 24 24" class="h-5 w-5 shrink-0" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                            <svg id="google-spinner" style="display:none" class="animate-spin-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                            <span id="google-btn-label">@(isInApp ? "Google: mở Chrome/Safari" : "Tiếp tục với Google")</span>
                        </button>

                        <!-- Divider -->
                        <div class="flex items-center gap-3 py-0.5">
                            <div class="h-px flex-1 bg-white/10"></div>
                            <span class="text-[11px] font-bold uppercase tracking-wider text-[#a08b7c]">
                                hoặc email
                            </span>
                            <div class="h-px flex-1 bg-white/10"></div>
                        </div>

                        <!-- Signup-Only Fields (FullName & Student/Teacher Role Selector) -->
                        <div id="signup-fields" style="@(isSignup ? "" : "display:none")" class="space-y-3">
                            <div class="relative">
                                <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#a08b7c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                <label for="full-name" class="sr-only">Họ và tên</label>
                                <input
                                    id="full-name"
                                    name="FullName"
                                    type="text"
                                    placeholder="Họ và tên"
                                    autocomplete="name"
                                    enterkeyhint="next"
                                    value="@fullNameValue"
                                    @(isSignup ? "required" : "")
                                    class="w-full min-h-12 rounded-2xl border border-[#bca58f]/45 bg-white/90 pl-11 pr-4 py-3 text-base font-semibold text-[#241710] placeholder:text-[#a08b7c] shadow-sm transition-all focus:border-[#b5502f]/50 focus:outline-none focus:ring-4 focus:ring-[#b5502f]/10"
                                />
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <button
                                    type="button"
                                    id="role-btn-student"
                                    data-role="student"
                                    class="flex min-h-12 items-center justify-center gap-1.5 rounded-2xl border px-2 text-sm font-bold transition-all cursor-pointer @(!isTeacher ? "border-[#b5502f]/60 bg-[#b5502f]/20 text-white" : "border-white/10 bg-white/[0.06] text-[#cbb7a6]")"
                                >
                                    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                                    <span class="truncate">Học sinh</span>
                                </button>
                                <button
                                    type="button"
                                    id="role-btn-teacher"
                                    data-role="teacher"
                                    class="flex min-h-12 items-center justify-center gap-1.5 rounded-2xl border px-2 text-sm font-bold transition-all cursor-pointer @(isTeacher ? "border-[#b5502f]/60 bg-[#b5502f]/20 text-white" : "border-white/10 bg-white/[0.06] text-[#cbb7a6]")"
                                >
                                    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
                                    <span class="truncate">Giáo viên</span>
                                </button>
                            </div>
                        </div>

                        <!-- Email Field -->
                        <div class="relative">
                            <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#a08b7c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            <label for="email" class="sr-only">Địa chỉ email</label>
                            <input
                                id="email"
                                name="Email"
                                type="email"
                                inputmode="email"
                                placeholder="Email"
                                autocomplete="email"
                                enterkeyhint="next"
                                value="@emailValue"
                                required
                                class="w-full min-h-12 rounded-2xl border border-[#bca58f]/45 bg-white/90 pl-11 pr-4 py-3 text-base font-semibold text-[#241710] placeholder:text-[#a08b7c] shadow-sm transition-all focus:border-[#b5502f]/50 focus:outline-none focus:ring-4 focus:ring-[#b5502f]/10"
                            />
                        </div>

                        <!-- Password Field -->
                        <div class="relative">
                            <svg class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-[#a08b7c]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <label for="password" class="sr-only">Mật khẩu</label>
                            <input
                                id="password"
                                name="Password"
                                type="password"
                                placeholder="@(isSignup ? "Mật khẩu (≥ 6 ký tự)" : "Mật khẩu")"
                                autocomplete="@(isSignup ? "new-password" : "current-password")"
                                enterkeyhint="done"
                                required
                                minlength="6"
                                class="w-full min-h-12 rounded-2xl border border-[#bca58f]/45 bg-white/90 pl-11 pr-12 py-3 text-base font-semibold text-[#241710] placeholder:text-[#a08b7c] shadow-sm transition-all focus:border-[#b5502f]/50 focus:outline-none focus:ring-4 focus:ring-[#b5502f]/10"
                            />
                            <button
                                type="button"
                                id="toggle-password-btn"
                                aria-label="Hiện mật khẩu"
                                class="absolute right-1.5 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-xl text-[#a08b7c] active:bg-black/5 cursor-pointer"
                            >
                                <svg id="icon-eye" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                                <svg id="icon-eye-off" style="display:none" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg>
                            </button>
                        </div>

                        <!-- Forgot Password Link (login mode only) -->
                        <div id="forgot-password-wrap" style="@(isSignup ? "display:none" : "")">
                            <a href="/auth/forgot-password" class="text-sm underline hover:text-white">Quên mật khẩu?</a>
                        </div>

                        <!-- Submit Button & Status -->
                        <div class="pt-0.5">
                            <button
                                type="submit"
                                id="auth-submit-btn"
                                class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-[#b5502f] text-sm font-black text-white shadow-[0_14px_36px_rgba(181,80,47,0.35)] transition-all active:scale-[0.98] disabled:opacity-60 cursor-pointer"
                            >
                                <svg id="submit-spinner" style="display:none" class="animate-spin-icon h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                <span id="submit-btn-label">@(isSignup ? "Tạo tài khoản" : "Đăng nhập")</span>
                                <svg id="submit-arrow" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                            </button>

                            <p
                                id="auth-status-text"
                                style="@(!string.IsNullOrWhiteSpace(statusMessage) ? "" : "display:none")"
                                class="mt-2.5 text-center text-[11px] font-bold leading-snug text-[#f1c46d]"
                            >
                                @statusMessage
                            </p>
                        </div>
                    </form>
                </div>

                <!-- Footer Links -->
                <p class="mt-4 px-1 pb-2 text-center text-[11px] font-semibold leading-5 text-[#7b6558] sm:mt-5 sm:text-xs">
                    <a href="/" class="underline decoration-[#bca58f] underline-offset-2 hover:text-[#241710]">
                        ← Về trang chủ
                    </a>
                    <span class="mx-1.5 text-[#bca58f]">·</span>
                    Không cần thẻ · Miễn phí
                </p>
            </div>
        </div>
    </div>

    <!-- Client Interactivity Script matching src/app/auth/page.tsx -->
    <script>
        (function () {
            var modeInput = document.getElementById('input-mode');
            var roleInput = document.getElementById('input-role');
            var returnUrlInput = document.getElementById('input-return-url');
            var referralInput = document.getElementById('input-referral');

            var tabLogin = document.getElementById('tab-login');
            var tabSignup = document.getElementById('tab-signup');
            var signupFields = document.getElementById('signup-fields');
            var fullNameInput = document.getElementById('full-name');
            var passwordInput = document.getElementById('password');
            var forgotWrap = document.getElementById('forgot-password-wrap');
            var desktopTitle = document.getElementById('desktop-title');
            var desktopSubtitle = document.getElementById('desktop-subtitle');
            var mobileSubtitle = document.getElementById('mobile-subtitle');
            var submitLabel = document.getElementById('submit-btn-label');
            var errorBox = document.getElementById('auth-error-box');
            var statusText = document.getElementById('auth-status-text');

            var roleStudentBtn = document.getElementById('role-btn-student');
            var roleTeacherBtn = document.getElementById('role-btn-teacher');
            var togglePwdBtn = document.getElementById('toggle-password-btn');
            var iconEye = document.getElementById('icon-eye');
            var iconEyeOff = document.getElementById('icon-eye-off');

            var referralBanner = document.getElementById('referral-gift-banner');
            var referralSignupText = document.getElementById('referral-gift-signup-text');
            var referralLoginText = document.getElementById('referral-gift-login-text');
            var referralSwitchSignupBtn = document.getElementById('referral-switch-signup');

            var googleBtn = document.getElementById('google-signin-btn');
            var googleIcon = document.getElementById('google-icon-svg');
            var googleSpinner = document.getElementById('google-spinner');
            var googleLabel = document.getElementById('google-btn-label');

            var authForm = document.getElementById('auth-form');
            var submitBtn = document.getElementById('auth-submit-btn');
            var submitSpinner = document.getElementById('submit-spinner');
            var submitArrow = document.getElementById('submit-arrow');

            var activeTabClass = 'min-h-11 flex-1 rounded-xl text-sm font-black transition-all sm:min-h-12 cursor-pointer bg-[#b5502f] text-white shadow-[0_8px_20px_rgba(181,80,47,0.35)]';
            var inactiveTabClass = 'min-h-11 flex-1 rounded-xl text-sm font-black transition-all sm:min-h-12 cursor-pointer text-[#cbb7a6] hover:text-[#f6efe6]';

            var activeRoleClass = 'flex min-h-12 items-center justify-center gap-1.5 rounded-2xl border px-2 text-sm font-bold transition-all cursor-pointer border-[#b5502f]/60 bg-[#b5502f]/20 text-white';
            var inactiveRoleClass = 'flex min-h-12 items-center justify-center gap-1.5 rounded-2xl border px-2 text-sm font-bold transition-all cursor-pointer border-white/10 bg-white/[0.06] text-[#cbb7a6]';

            function setMode(newMode) {
                var isSignup = newMode === 'signup';
                if (modeInput) modeInput.value = isSignup ? 'signup' : 'login';
                if (tabLogin) tabLogin.className = !isSignup ? activeTabClass : inactiveTabClass;
                if (tabSignup) tabSignup.className = isSignup ? activeTabClass : inactiveTabClass;
                if (signupFields) signupFields.style.display = isSignup ? 'block' : 'none';
                if (fullNameInput) fullNameInput.required = isSignup;
                if (passwordInput) {
                    passwordInput.placeholder = isSignup ? 'Mật khẩu (≥ 6 ký tự)' : 'Mật khẩu';
                    passwordInput.autocomplete = isSignup ? 'new-password' : 'current-password';
                }
                if (forgotWrap) forgotWrap.style.display = isSignup ? 'none' : 'block';
                if (desktopTitle) desktopTitle.textContent = isSignup ? 'Tạo tài khoản' : 'Đăng nhập';
                if (desktopSubtitle) desktopSubtitle.textContent = isSignup ? 'Bắt đầu miễn phí — không cần thẻ.' : 'Tiếp tục lộ trình từ vựng của bạn.';
                if (mobileSubtitle) mobileSubtitle.textContent = isSignup ? 'Tạo tài khoản miễn phí' : 'Chào mừng trở lại';
                if (submitLabel) submitLabel.textContent = isSignup ? 'Tạo tài khoản' : 'Đăng nhập';
                if (referralSignupText) referralSignupText.style.display = isSignup ? 'inline' : 'none';
                if (referralLoginText) referralLoginText.style.display = isSignup ? 'none' : 'inline';
                if (errorBox) errorBox.style.display = 'none';
                document.title = isSignup ? 'Đăng Ký — LingoPro' : 'Đăng Nhập — LingoPro';
            }

            function setRole(newRole) {
                var isTeacher = newRole === 'teacher';
                if (roleInput) roleInput.value = isTeacher ? 'teacher' : 'student';
                if (roleStudentBtn) roleStudentBtn.className = !isTeacher ? activeRoleClass : inactiveRoleClass;
                if (roleTeacherBtn) roleTeacherBtn.className = isTeacher ? activeRoleClass : inactiveRoleClass;
            }

            if (tabLogin) tabLogin.addEventListener('click', function () { setMode('login'); });
            if (tabSignup) tabSignup.addEventListener('click', function () { setMode('signup'); });
            if (referralSwitchSignupBtn) referralSwitchSignupBtn.addEventListener('click', function () { setMode('signup'); });

            if (roleStudentBtn) roleStudentBtn.addEventListener('click', function () { setRole('student'); });
            if (roleTeacherBtn) roleTeacherBtn.addEventListener('click', function () { setRole('teacher'); });

            // Referral attribution cookie shared with the SPA (same key/format as src/lib/referral-tracker.ts)
            try {
                var refPattern = /^[A-Z0-9_-]{3,32}$/;
                var cookieMatch = document.cookie.split(';').map(function (c) { return c.trim(); })
                    .filter(function (c) { return c.indexOf('lingopro_ref=') === 0; })[0];
                var storedRef = cookieMatch ? decodeURIComponent(cookieMatch.substring('lingopro_ref='.length)).trim().toUpperCase() : '';
                var incomingRef = referralInput && referralInput.value ? referralInput.value.trim().toUpperCase() : '';

                if (refPattern.test(incomingRef)) {
                    document.cookie = 'lingopro_ref=' + encodeURIComponent(incomingRef) +
                        '; path=/; max-age=' + (30 * 24 * 60 * 60) + '; SameSite=Lax' +
                        (window.location.protocol === 'https:' ? '; Secure' : '');
                    storedRef = incomingRef;
                }

                if (refPattern.test(storedRef) && referralBanner) {
                    referralBanner.style.display = 'flex';
                    if (referralInput && !referralInput.value) referralInput.value = storedRef;
                }
            } catch (_) {}

            // Show/Hide Password Toggle
            if (togglePwdBtn && passwordInput) {
                togglePwdBtn.addEventListener('click', function () {
                    var showing = passwordInput.type === 'text';
                    passwordInput.type = showing ? 'password' : 'text';
                    togglePwdBtn.setAttribute('aria-label', showing ? 'Hiện mật khẩu' : 'Ẩn mật khẩu');
                    if (iconEye) iconEye.style.display = showing ? 'block' : 'none';
                    if (iconEyeOff) iconEyeOff.style.display = showing ? 'none' : 'block';
                });
            }

            // Form submit loading indicator
            if (authForm) {
                authForm.addEventListener('submit', function () {
                    var currentMode = modeInput ? modeInput.value : 'login';
                    if (submitBtn) submitBtn.disabled = true;
                    if (submitSpinner) submitSpinner.style.display = 'block';
                    if (submitArrow) submitArrow.style.display = 'none';
                    if (statusText) {
                        statusText.textContent = currentMode === 'signup' ? 'Đang tạo tài khoản...' : 'Đang đăng nhập...';
                        statusText.style.display = 'block';
                    }
                });
            }

            // Google Sign-In Handler
            if (googleBtn) {
                googleBtn.addEventListener('click', function () {
                    if (googleBtn.disabled) return;
                    googleBtn.disabled = true;
                    if (googleIcon) googleIcon.style.display = 'none';
                    if (googleSpinner) googleSpinner.style.display = 'block';
                    if (googleLabel) googleLabel.textContent = 'Đang mở Google…';
                    if (statusText) {
                        statusText.textContent = 'Đang mở Google...';
                        statusText.style.display = 'block';
                    }
                    var ret = returnUrlInput ? returnUrlInput.value : '/app';
                    var r = roleInput ? roleInput.value : 'student';
                    window.location.href = '/auth/google?returnUrl=' + encodeURIComponent(ret) + '&role=' + encodeURIComponent(r);
                });
            }

            // In-App Browser External Open & Copy Link Handlers
            var btnOpenExternal = document.getElementById('btn-open-external');
            var btnCopyAuthUrl = document.getElementById('btn-copy-auth-url');
            var btnCopyAuthLabel = document.getElementById('btn-copy-auth-label');

            if (btnOpenExternal) {
                btnOpenExternal.addEventListener('click', function () {
                    var u = window.location;
                    var isAndroidUa = /Android/i.test(navigator.userAgent || '');
                    if (isAndroidUa) {
                        var chromeIntent = 'intent://' + u.host + u.pathname + u.search + u.hash + '#Intent;scheme=https;package=com.android.chrome;end';
                        window.location.href = chromeIntent;
                        return;
                    }
                    if (navigator.clipboard) {
                        navigator.clipboard.writeText(u.href);
                    }
                });
            }

            if (btnCopyAuthUrl) {
                btnCopyAuthUrl.addEventListener('click', function () {
                    var targetUrl = btnCopyAuthUrl.getAttribute('data-auth-url') || window.location.href;
                    if (navigator.clipboard) {
                        navigator.clipboard.writeText(targetUrl).then(function () {
                            if (btnCopyAuthLabel) {
                                btnCopyAuthLabel.textContent = 'Đã copy link!';
                                setTimeout(function () { btnCopyAuthLabel.textContent = 'Copy link'; }, 2000);
                            }
                        });
                    }
                });
            }
        })();
    </script>
</body>
</html>
