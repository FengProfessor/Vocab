@model LingoPro.WebApi.Services.Ipa.IpaPairView
@{
    // Vietnamese label for the sub-type of a phoneme tile.
    static string Label(string subType) => subType switch
    {
        "long-vowel" => "Âm dài",
        "short-vowel" => "Âm ngắn",
        "voiceless-consonant" => "Vô thanh",
        _ => "Hữu thanh",
    };
    var tiles = new[] { Model.First, Model.Second };
}
<div class="flex flex-col justify-between gap-2.5 rounded-xl border border-[#bca58f]/50 bg-white/70 p-3 transition hover:border-[#b5502f]/60 sm:p-3.5">
    <div class="flex items-start justify-between gap-2 border-b border-[#bca58f]/30 pb-2">
        <div>
            <span class="text-xs font-bold text-[#241710]">@Model.Pair.Title</span>
            <p class="mt-0.5 text-[11px] text-[#241710]/60">@Model.Pair.MouthPosition</p>
        </div>
        <span class="shrink-0 rounded-md bg-[#bca58f]/20 px-2 py-0.5 text-[10px] font-medium text-[#241710]/60">Cặp #@(Model.Index + 1)</span>
    </div>
    <div class="relative grid grid-cols-2 items-center gap-2">
        @foreach (var t in tiles)
        {
            <div role="button" tabindex="0" data-ipa-open="@t.Id" data-ipa-card="@t.Id" data-type="@t.Type" data-hard="@(t.DifficultyForVn == "high" ? "true" : "false")"
                 class="ipa-card group cursor-pointer rounded-lg border border-[#bca58f]/50 bg-[#f6efe6]/60 p-2.5 text-center transition hover:border-[#b5502f] hover:bg-white">
                <div class="mb-1 flex items-center justify-between text-[10px] text-[#241710]/60">
                    <span class="truncate font-medium">@Label(t.SubType)</span>
                    <button type="button" data-ipa-play="@t.AnchorWord" class="p-0.5 hover:text-[#b5502f]" title="Nghe phát âm" aria-label="Nghe từ @t.AnchorWord">🔊</button>
                </div>
                <div class="font-mono text-xl font-black text-[#241710] transition group-hover:text-[#b5502f]">/@t.Symbol/</div>
                <div class="mt-0.5 text-xs font-semibold text-[#241710]/80">@t.AnchorWord</div>
            </div>
        }
        <div class="pointer-events-none absolute left-1/2 top-1/2 z-10 flex h-6 w-6 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-[#bca58f]/50 bg-[#f6efe6] text-[10px] text-[#241710]/60">↔</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Pair.Tip))
    {
        <p class="rounded-md bg-[#bca58f]/15 px-2 py-1 text-[11px] italic text-[#241710]/70">💡 @Model.Pair.Tip</p>
    }
</div>
