@* Ebook reader modal (port of EbookReaderModal.tsx). The markdown is fetched lazily by lead-magnet.js from
   /lead-magnet/sat-thu-toeic-listening-lead-magnet.md (served from the repo public folder) and rendered client-side. *@
<div id="lm-reader" hidden role="dialog" aria-modal="true" aria-labelledby="lm-reader-title" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-2 backdrop-blur-md sm:p-4 md:p-6">
    <div id="lm-reader-panel" class="flex h-[92vh] w-full max-w-5xl flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl transition-all duration-300">
        <div class="flex h-16 shrink-0 items-center justify-between border-b border-slate-200 bg-white/95 px-4 backdrop-blur-md sm:px-6">
            <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-xl border border-indigo-200 bg-indigo-50 font-bold text-indigo-600">📖</div>
                <div>
                    <h3 id="lm-reader-title" class="max-w-[220px] truncate text-sm font-bold text-slate-900 sm:max-w-md sm:text-base">Bách Khoa Sát Thủ Bài Nghe TOEIC ETS 2024–2026</h3>
                    <span class="hidden font-mono text-[10px] text-emerald-600 sm:inline">Phiên bản Master Edition (LP-LM-TOEIC-LISTEN-2026)</span>
                </div>
            </div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <button type="button" data-reader-toc-toggle aria-expanded="false" class="flex cursor-pointer items-center gap-1 rounded-xl border border-slate-200 bg-slate-100 px-2.5 py-1.5 text-xs font-semibold text-slate-700 transition hover:bg-slate-200">☰ <span class="hidden sm:inline">Mục Lục</span></button>
                <a href="/downloads/sat-thu-toeic-listening-lead-magnet.md" download class="flex items-center gap-1 rounded-xl bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-500">⬇️ <span class="hidden sm:inline">Tải File .MD</span></a>
                <button type="button" data-reader-fullscreen title="Toàn màn hình" aria-label="Bật/tắt toàn màn hình" class="cursor-pointer rounded-xl p-1.5 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900">⛶</button>
                <button type="button" data-reader-close aria-label="Đóng" class="ml-1 cursor-pointer rounded-xl p-1.5 text-lg leading-none text-slate-500 transition hover:bg-rose-50 hover:text-rose-600">✕</button>
            </div>
        </div>

        <div class="relative flex flex-1 overflow-hidden">
            <div id="lm-reader-toc" hidden class="absolute inset-y-0 left-0 z-20 w-72 space-y-1.5 overflow-y-auto border-r border-slate-200 bg-white p-4 shadow-2xl sm:w-80">
                <div class="flex items-center justify-between border-b border-slate-200 pb-3">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Mục Lục Trực Tiếp</span>
                    <button type="button" data-reader-toc-toggle aria-label="Đóng mục lục" class="cursor-pointer p-1 text-slate-400 hover:text-slate-700">✕</button>
                </div>
                <div id="lm-reader-toc-list" class="divide-y divide-slate-100 pt-1"></div>
            </div>

            <div id="lm-reader-content" class="lm-prose flex-1 overflow-y-auto px-4 py-8 text-slate-800 sm:px-10">
                <div id="lm-reader-loading" class="space-y-3 py-20 text-center">
                    <div class="lm-spin mx-auto h-8 w-8 rounded-full border-2 border-indigo-600 border-t-transparent"></div>
                    <p class="text-xs text-slate-500">Đang tải toàn bộ nội dung Ebook...</p>
                </div>
            </div>
        </div>
    </div>
</div>
