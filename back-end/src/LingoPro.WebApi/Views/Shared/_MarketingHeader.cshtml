@* Shared marketing header used across public student SSR pages (/, /ipa, /sat-thu-toeic-listening).
   Set ViewData["ActiveNav"] to "home", "ipa", or "toeic" to highlight the active route. *@
@{
    var active = ViewData["ActiveNav"] as string ?? string.Empty;
    var isHome = string.Equals(active, "home", StringComparison.OrdinalIgnoreCase);
    string AnchorHref(string hash) => isHome ? hash : "/" + hash;
    string NavClass(string key) =>
        string.Equals(active, key, StringComparison.OrdinalIgnoreCase)
            ? "whitespace-nowrap font-black text-[#241710] underline decoration-[#b5502f] decoration-2 underline-offset-8 transition-colors"
            : "whitespace-nowrap transition-colors hover:text-[#241710]";
}
<header class="sticky top-0 z-50 border-b border-[#241710]/10 bg-[#f6efe6]/90 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href="/" class="flex shrink-0 items-center gap-2.5 font-black tracking-tight text-[#241710]">
            <span class="flex size-9 items-center justify-center rounded-xl bg-[#241710] text-[#f1c46d]">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
                    <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" />
                    <path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4" />
                    <path d="M17.599 6.5a3 3 0 0 0 .399-1.375" />
                    <path d="M6.003 5.125A3 3 0 0 0 6.401 6.5" />
                    <path d="M3.477 10.896a4 4 0 0 1 .585-.396" />
                    <path d="M19.938 10.5a4 4 0 0 1 .585.396" />
                    <path d="M6 18a4 4 0 0 1-1.967-.516" />
                    <path d="M19.967 17.484A4 4 0 0 1 18 18" />
                </svg>
            </span>
            LingoPro
        </a>

        <nav class="hidden items-center gap-7 text-sm font-semibold text-[#5e4b40] md:flex" aria-label="Điều hướng chính">
            <a href="@AnchorHref("#cach-hoc")" class="whitespace-nowrap transition-colors hover:text-[#241710]">Cách học</a>
            <a href="/ipa" class="@NavClass("ipa")" @(active == "ipa" ? "aria-current=page" : "")>Phiên Âm IPA</a>
            <a href="/sat-thu-toeic-listening" class="@NavClass("toeic")" @(active == "toeic" ? "aria-current=page" : "")>Sát Thủ TOEIC</a>
            <a href="@AnchorHref("#video-demo")" class="whitespace-nowrap transition-colors hover:text-[#241710]">Video</a>
            <a href="@AnchorHref("#demo")" class="whitespace-nowrap transition-colors hover:text-[#241710]">Thử tra từ</a>
            <a href="/for-teacher" class="whitespace-nowrap transition-colors hover:text-[#241710]">Giáo viên</a>
            <a href="@AnchorHref("#bang-gia")" class="whitespace-nowrap transition-colors hover:text-[#241710]">Giá</a>
            <a href="@AnchorHref("#faq")" class="whitespace-nowrap transition-colors hover:text-[#241710]">FAQ</a>
        </nav>

        <div class="flex shrink-0 items-center gap-2">
            <a href="/download"
               class="hidden items-center gap-1.5 whitespace-nowrap rounded-full border border-[#241710]/15 bg-white/80 px-3.5 py-2 text-xs font-bold text-[#241710] transition-colors hover:bg-white sm:inline-flex">
                <svg class="size-3.5 text-[#b5502f]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 17V3" />
                    <path d="m6 11 6 6 6-6" />
                    <path d="M19 21H5" />
                </svg>
                Desktop
            </a>
            <a href="/auth"
               class="inline-flex items-center gap-2 whitespace-nowrap rounded-full bg-[#241710] px-4 py-2.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5">
                Dùng miễn phí
                <svg class="size-4 text-[#f1c46d]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m12 5 7 7-7 7" />
                </svg>
            </a>
        </div>
    </div>
</header>
