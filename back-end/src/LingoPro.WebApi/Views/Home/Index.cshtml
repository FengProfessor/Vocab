@model LingoPro.Application.Features.Seo.Queries.LandingPageSeoDto
@{
    Layout = null;
    ViewData["ActiveNav"] = "home";
    var siteUrl = string.IsNullOrWhiteSpace(Model?.CanonicalUrl) ? "https://lingopro.online" : Model.CanonicalUrl.TrimEnd('/');
    var pageTitle = string.IsNullOrWhiteSpace(Model?.PageTitle)
        ? "LingoPro — Học từ vựng tiếng Anh, tra từ 1 chạm, nhớ lâu với FSRS"
        : Model.PageTitle;
    var metaDesc = string.IsNullOrWhiteSpace(Model?.MetaDescription)
        ? "App học từ vựng cho người Việt: tra từ trên web, flashcard FSRS, lộ trình THPT · TOEIC · IELTS. Miễn phí bắt đầu — 5–8 phút/ngày."
        : Model.MetaDescription;
    var vocabPacksText = (Model?.TotalVocabularyPacks ?? 660) >= 660 ? $"{Model?.TotalVocabularyPacks ?? 660}+" : "660+";
}
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="theme-color" content="#241710" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta name="keywords" content="học từ vựng, học từ vựng tiếng Anh, tra từ tiếng Anh, flashcard FSRS, spaced repetition, ôn từ vựng, từ vựng TOEIC, từ vựng IELTS, từ vựng THPT, Anki tiếng Việt, LingoPro" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@siteUrl" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- OpenGraph / Facebook / Zalo SEO Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="LingoPro" />
    <meta property="og:title" content="LingoPro — Học từ vựng, tra từ 1 chạm, nhớ lâu hơn" />
    <meta property="og:description" content="Tra từ trên web · flashcard FSRS · lộ trình sẵn cho người Việt. Bắt đầu miễn phí." />
    <meta property="og:url" content="@siteUrl" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LingoPro — Học từ vựng tiếng Anh nhớ lâu hơn" />
    <meta name="twitter:description" content="Tra từ 1 chạm, ôn đúng lúc bằng FSRS. Miễn phí bắt đầu." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS v4 Browser Runtime -->
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@@latest"></script>

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "LingoPro",
          "applicationCategory": "EducationalApplication",
          "operatingSystem": "Web, Windows",
          "url": "@siteUrl",
          "description": "App học từ vựng tiếng Anh: tra từ 1 chạm, flashcard FSRS, lộ trình THPT · TOEIC · IELTS cho người Việt.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "VND",
            "description": "Gói Free — nâng Pro tùy chọn"
          },
          "inLanguage": "vi"
        },
        {
          "@@type": "WebSite",
          "name": "LingoPro",
          "url": "@siteUrl",
          "inLanguage": "vi-VN",
          "description": "Học từ vựng tiếng Anh với tra từ 1 chạm và flashcard FSRS."
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "LingoPro học từ vựng bằng cách nào?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Tra từ trên web, lưu vào kho, rồi ôn lại theo lịch FSRS (spaced repetition) — mỗi chặng khoảng 5–8 phút."
              }
            },
            {
              "@@type": "Question",
              "name": "Có miễn phí không?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Có gói Free: flashcard FSRS, lưu 200 từ mới/tháng, lộ trình sẵn và tra từ AI 5 lượt/ngày. Nâng Pro khi cần không giới hạn."
              }
            },
            {
              "@@type": "Question",
              "name": "LingoPro khác Anki ở điểm nào?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "LingoPro có sẵn lộ trình Việt hóa, tra–lưu 1 chạm và nhắc ôn. Anki mạnh hơn nếu bạn thích tự dựng toàn bộ hệ thống."
              }
            },
            {
              "@@type": "Question",
              "name": "Có cần cài app không?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Học ngay trên web. Có thêm app Desktop và Chrome Extension để tra từ khi đọc trang."
              }
            }
          ]
        },
        {
          "@@type": "VideoObject",
          "name": "Demo LingoPro — tra từ và lưu vào kho",
          "description": "Xem cách bôi đen từ trên web, lưu vào kho riêng và ôn theo FSRS với LingoPro.",
          "thumbnailUrl": "@siteUrl/images/intro-save-word-poster.webp",
          "contentUrl": "@siteUrl/intro-save-word.mp4?v=2",
          "embedUrl": "@siteUrl/#video-demo",
          "uploadDate": "2026-06-01",
          "inLanguage": "vi"
        },
        {
          "@@type": "VideoObject",
          "name": "Demo tra từ 1 chạm trên web — LingoPro Extension",
          "description": "Tra từ ngay trên trang đang đọc bằng Chrome Extension LingoPro.",
          "thumbnailUrl": "@siteUrl/images/extension-lookup-poster.webp",
          "contentUrl": "@siteUrl/extension-lookup.mp4?v=2",
          "embedUrl": "@siteUrl/#video-demo",
          "uploadDate": "2026-06-01",
          "inLanguage": "vi"
        }
      ]
    }
    </script>

    <style>
        body {
            font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
        }
        @@keyframes spinIcon {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-icon { animation: spinIcon 1s linear infinite; }
    </style>
</head>
<body class="min-h-dvh overflow-x-hidden bg-[#f6efe6] text-[#241710] antialiased">
    <!-- AuthRedirectGate -->
    <script>
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.get('stay') === '1') return;
                var cached = localStorage.getItem('lingopro_last_profile_v1');
                if (cached) {
                    var parsed = JSON.parse(cached);
                    if (parsed && parsed.id) {
                        window.location.replace('/app/journey');
                    }
                }
            } catch (_) {}
        })();
    </script>

    <div class="min-h-dvh overflow-hidden bg-[#f6efe6] text-[#241710]">
        <partial name="_MarketingHeader" />

        <main>
            <!-- 2. Hero + LearnerTabs (phong cách /for-teacher, giữ màu gốc #f6efe6 / #241710 / #b5502f / #f1c46d) -->
            <section class="relative px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-24">
                <div class="pointer-events-none absolute -right-32 top-0 size-[32rem] rounded-full bg-[#f1c46d]/30 blur-3xl"></div>
                <div class="pointer-events-none absolute -left-48 bottom-0 size-96 rounded-full bg-[#e57b52]/20 blur-3xl"></div>
                <div class="relative mx-auto grid max-w-7xl items-start gap-14 lg:grid-cols-[1.08fr_0.92fr]">
                    <!-- Left Column: Tabs + Editorial Hero Copy -->
                    <div>
                        <div class="flex w-full rounded-full border border-[#d7c7b6] bg-white/85 p-1.5 backdrop-blur-sm sm:max-w-md">
                            <button type="button"
                                    data-learner-tab="daily"
                                    onclick="setActiveLearner('daily')"
                                    class="learner-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors bg-[#241710] text-[#f1c46d] cursor-pointer">
                                Giao tiếp
                            </button>
                            <button type="button"
                                    data-learner-tab="toeic"
                                    onclick="setActiveLearner('toeic')"
                                    class="learner-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors border border-transparent bg-transparent text-[#5e4b40] hover:bg-white cursor-pointer">
                                Luyện TOEIC
                            </button>
                            <button type="button"
                                    data-learner-tab="ielts"
                                    onclick="setActiveLearner('ielts')"
                                    class="learner-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors border border-transparent bg-transparent text-[#5e4b40] hover:bg-white cursor-pointer">
                                IELTS &amp; THPT
                            </button>
                        </div>

                        <div class="mt-8">
                            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#241710]/10 bg-white/80 px-4 py-2 text-xs font-black uppercase tracking-[0.16em] text-[#5e4b40]">
                                <i data-lucide="sparkles" class="size-4 text-[#b5502f]"></i>
                                <span id="learner-badge">App học từ vựng · Thuật toán FSRS</span>
                            </div>
                            <h1 class="max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.055em] text-[#241710] sm:text-7xl">
                                <span id="learner-lead">Tra từ 1 chạm.</span>
                                <span id="learner-accent" class="mt-2 block text-[#b5502f]">Nhớ lâu không cần nhồi.</span>
                            </h1>
                            <p id="learner-sub" class="mt-7 max-w-2xl text-lg font-medium leading-8 text-[#5e4b40] sm:text-xl">
                                Tra từ trên web → lưu kho riêng → ôn đúng lúc sắp quên bằng FSRS. Mỗi chặng chỉ 5–8 phút, lộ trình Việt hóa sẵn sàng.
                            </p>
                            <ul id="learner-bullets" class="mt-7 space-y-2.5">
                                <li class="flex items-center gap-3 font-semibold text-[#241710]">
                                    <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#b5502f]"></i>
                                    <span>Bôi đen từ trên web — hiện nghĩa Việt, IPA và ví dụ ngay</span>
                                </li>
                                <li class="flex items-center gap-3 font-semibold text-[#241710]">
                                    <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#b5502f]"></i>
                                    <span>Nhắc ôn tự động đúng thời điểm não sắp quên theo FSRS</span>
                                </li>
                                <li class="flex items-center gap-3 font-semibold text-[#241710]">
                                    <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#b5502f]"></i>
                                    <span>Hơn 9.000+ từ vựng chia sẵn theo chặng ngắn 5–8 phút</span>
                                </li>
                            </ul>
                            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                                <a id="learner-cta-primary"
                                   href="/auth"
                                   class="inline-flex items-center justify-center gap-2 rounded-2xl bg-[#b5502f] px-7 py-4 font-black text-white shadow-[0_12px_0_#241710] transition-transform hover:-translate-y-1 hover:bg-[#a04428]">
                                    <span id="learner-cta-text">Bắt đầu miễn phí</span>
                                    <i data-lucide="arrow-right" class="size-5"></i>
                                </a>
                                <a href="#demo"
                                   class="inline-flex items-center justify-center gap-2 rounded-2xl border-2 border-[#241710]/20 bg-white px-7 py-4 font-black text-[#241710] shadow-xs transition-colors hover:border-[#241710]/40 hover:bg-[#fffaf5]">
                                    <i data-lucide="search" class="size-5 text-[#b5502f]"></i>
                                    Thử tra từ ngay
                                </a>
                            </div>
                            <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold text-[#6d574a]">
                                <span class="flex items-center gap-2">
                                    <i data-lucide="shield-check" class="size-4 text-[#2d7f5e]"></i> Miễn phí bắt đầu
                                </span>
                                <span>5–8 phút / chặng</span>
                                <span>Đồng bộ Web &amp; Extension</span>
                            </p>
                        </div>
                    </div>

                    <!-- Right Column: Product Dashboard Preview Card (phong cách /for-teacher) -->
                    <div class="relative mx-auto w-full max-w-xl">
                        <div class="absolute -inset-4 rotate-3 rounded-[2rem] bg-[#f1c46d] sm:-inset-5"></div>
                        <div class="relative rounded-[2rem] border border-[#241710]/10 bg-[#241710] p-5 text-white shadow-2xl sm:p-7">
                            <div class="flex items-center justify-between border-b border-white/10 pb-5">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#cbb7a6]">Lộ trình cá nhân hóa</p>
                                    <p class="mt-1 text-xl font-black text-white">3 bước nhớ từ vựng sâu</p>
                                </div>
                                <div class="rounded-xl bg-[#f1c46d] px-3 py-2 text-xs font-black uppercase tracking-wider text-[#241710]">
                                    FSRS v5
                                </div>
                            </div>

                            <div class="mt-5 grid grid-cols-3 gap-3">
                                <div class="rounded-2xl bg-white/[0.07] p-3">
                                    <p class="text-2xl font-black text-[#f1c46d]">9.000+</p>
                                    <p class="mt-1 text-xs font-semibold text-[#cbb7a6]">Từ vựng</p>
                                </div>
                                <div class="rounded-2xl bg-white/[0.07] p-3">
                                    <p class="text-2xl font-black text-[#f1c46d]">@vocabPacksText</p>
                                    <p class="mt-1 text-xs font-semibold text-[#cbb7a6]">Chặng học</p>
                                </div>
                                <div class="rounded-2xl bg-white/[0.07] p-3">
                                    <p class="text-2xl font-black text-[#f1c46d]">30+</p>
                                    <p class="mt-1 text-xs font-semibold text-[#cbb7a6]">Lộ trình</p>
                                </div>
                            </div>

                            <div class="mt-5 rounded-2xl bg-white/[0.07] p-4">
                                <div class="mb-4 flex items-center justify-between">
                                    <p class="font-bold text-white">Chu trình học mỗi ngày</p>
                                    <span class="rounded-full bg-[#b5502f]/30 px-2.5 py-1 text-xs font-bold text-[#ff9c89]">5–8 phút</span>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex items-center gap-3">
                                        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#f1c46d]/20 text-xs font-black text-[#f1c46d]">01</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold text-white">Tra từ 1 chạm</p>
                                            <p class="truncate text-xs text-[#cbb7a6]">Bôi đen trên web — hiện nghĩa Việt, IPA, ví dụ</p>
                                        </div>
                                        <span class="text-xs font-black text-[#f1c46d]">Tức thì</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#f1c46d]/20 text-xs font-black text-[#f1c46d]">02</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold text-white">Lưu vào kho riêng</p>
                                            <p class="truncate text-xs text-[#cbb7a6]">Tự động tạo flashcard kèm âm thanh &amp; ngữ cảnh</p>
                                        </div>
                                        <span class="text-xs font-black text-[#f1c46d]">1 chạm</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-[#f1c46d]/20 text-xs font-black text-[#f1c46d]">03</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold text-white">Ôn đúng lúc sắp quên</p>
                                            <p class="truncate text-xs text-[#cbb7a6]">FSRS tính lịch riêng cho từng từ khó / dễ</p>
                                        </div>
                                        <span class="text-xs font-black text-[#74cbb2]">94% nhớ</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-5 flex items-center justify-between gap-3 rounded-2xl bg-[#f1c46d] p-4 text-[#241710]">
                                <div class="flex items-center gap-3">
                                    <i data-lucide="zap" class="size-5 shrink-0"></i>
                                    <p class="text-sm font-bold">Lộ trình: @string.Join(" · ", Model?.FeaturedExamTracks is { Count: > 0 } ? Model.FeaturedExamTracks : new[] { "IELTS", "TOEIC", "THPT", "Giao tiếp" })</p>
                                </div>
                                <a href="/auth" class="shrink-0 rounded-xl bg-[#241710] px-3 py-1.5 text-xs font-black text-white transition-transform hover:-translate-y-0.5">
                                    Học ngay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. Dải kết quả (giống bố cục /for-teacher) -->
            <section class="border-y border-[#241710]/10 bg-white/75 px-4 py-10 sm:px-6">
                <div class="mx-auto grid max-w-7xl gap-7 md:grid-cols-3">
                    <div class="flex items-start gap-4">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#f1c46d]/55 text-[#241710]">
                            <i data-lucide="clock-3" class="size-5"></i>
                        </span>
                        <div>
                            <p class="text-xl font-black text-[#241710]">Chỉ 5–8 phút/ngày</p>
                            <p class="mt-1 text-sm font-medium leading-6 text-[#5e4b40]">chặng học ngắn gọn, dễ duy trì thói quen mỗi ngày</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#f1c46d]/55 text-[#241710]">
                            <i data-lucide="mouse-pointer-click" class="size-5"></i>
                        </span>
                        <div>
                            <p class="text-xl font-black text-[#241710]">Tra &amp; lưu 1 chạm</p>
                            <p class="mt-1 text-sm font-medium leading-6 text-[#5e4b40]">không mất hàng giờ tự gõ từng mặt thẻ flashcard</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#f1c46d]/55 text-[#241710]">
                            <i data-lucide="brain" class="size-5"></i>
                        </span>
                        <div>
                            <p class="text-xl font-black text-[#241710]">Nhắc ôn tự động FSRS</p>
                            <p class="mt-1 text-sm font-medium leading-6 text-[#5e4b40]">từ khó ôn dày, từ đã thuộc giãn thưa để nhớ lâu dài</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. Tương tác tra từ trực tiếp (DictionaryDemo) -->
            <section id="demo" class="px-4 py-24 sm:px-6">
                <div class="mx-auto grid max-w-7xl items-start gap-12 lg:grid-cols-[0.9fr_1.1fr]">
                    <div>
                        <p class="text-sm font-black uppercase tracking-[0.18em] text-[#b5502f]">Thử ngay không cần tài khoản</p>
                        <h2 class="mt-4 text-4xl font-black tracking-[-0.04em] text-[#241710] sm:text-5xl">
                            Tra thử một từ — thấy ngay cách LingoPro hoạt động.
                        </h2>
                        <p class="mt-5 font-medium leading-8 text-[#5e4b40]">
                            Xem nghĩa tiếng Việt chọn lọc, phiên âm IPA chuẩn, âm thanh UK/US và câu ví dụ sát thực tế. Chỉ đăng ký khi bạn muốn lưu vào kho riêng để ôn tập.
                        </p>
                        <ul class="mt-7 space-y-3 text-sm font-semibold text-[#241710]">
                            <li class="flex items-center gap-3">
                                <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#2d7f5e]"></i>
                                <span>Kết hợp kho từ điển biên soạn sẵn &amp; giải thích AI</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#2d7f5e]"></i>
                                <span>Đồng bộ xuyên suốt giữa Web, Desktop và Chrome Extension</span>
                            </li>
                            <li class="flex items-center gap-3">
                                <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#2d7f5e]"></i>
                                <span>Biết ngay sản phẩm có hợp với mình chỉ trong 30 giây</span>
                            </li>
                        </ul>
                    </div>

                    <!-- DictionaryDemo Widget Card -->
                    <div class="rounded-[2rem] border border-[#241710]/10 bg-white p-6 shadow-xl sm:p-8">
                        <form id="dict-demo-form" class="relative flex gap-2 rounded-2xl border-2 border-[#d7c7b6] bg-[#fffaf5] p-2 focus-within:border-[#b5502f]">
                            <input
                                id="dict-demo-input"
                                type="text"
                                placeholder="Gõ một từ tiếng Anh… vd: resilient"
                                autocomplete="off"
                                autocorrect="off"
                                spellcheck="false"
                                class="h-12 flex-1 rounded-xl bg-transparent px-4 text-base font-semibold text-[#241710] placeholder:font-normal placeholder:text-[#9a8578] focus:outline-none"
