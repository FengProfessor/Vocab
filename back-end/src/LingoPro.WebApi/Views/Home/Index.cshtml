                                Dành cho Giáo viên &amp; Trung tâm
                            </a>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- 13. Footer (đồng bộ phong cách với /for-teacher) -->
        <footer class="border-t border-[#241710]/10 px-4 py-10 sm:px-6">
            <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 text-sm font-semibold text-[#5e4b40] sm:flex-row">
                <a href="/" class="flex items-center gap-2 font-black text-[#241710]">
                    <span class="flex size-7 items-center justify-center rounded-lg bg-[#241710] text-[#f1c46d]">
                        <i data-lucide="brain" class="size-4"></i>
                    </span>
                    LingoPro
                </a>
                <p>Học từ vựng tiếng Anh · Tra từ 1 chạm · Ghi nhớ dài hạn với FSRS.</p>
                <div class="flex flex-wrap items-center gap-5">
                    <a href="/ipa" class="transition-colors hover:text-[#241710]">Phiên Âm IPA</a>
                    <a href="/sat-thu-toeic-listening" class="transition-colors hover:text-[#241710]">Sát Thủ TOEIC</a>
                    <a href="/for-teacher" class="transition-colors hover:text-[#241710]">Giáo viên</a>
                    <a href="/download" class="transition-colors hover:text-[#241710]">Desktop</a>
                    <a href="/auth" class="font-black text-[#241710] hover:text-[#b5502f]">Đăng nhập</a>
                </div>
            </div>
        </footer>
    </div>

    <!-- Client-side Interactive Scripts (Learner Tabs, FAQ Accordion, DictionaryDemo) -->
    <script>
        if (window.lucide) {
            window.lucide.createIcons();
        }

        const learnerContent = {
            daily: {
                badge: 'App học từ vựng · Thuật toán FSRS',
                lead: 'Tra từ 1 chạm.',
                accent: 'Nhớ lâu không cần nhồi.',
                sub: 'Tra từ trên web → lưu kho riêng → ôn đúng lúc sắp quên bằng FSRS. Mỗi chặng chỉ 5–8 phút, lộ trình Việt hóa sẵn sàng.',
                bullets: [
                    'Bôi đen từ trên web — hiện nghĩa Việt, IPA và ví dụ ngay',
                    'Nhắc ôn tự động đúng thời điểm não sắp quên theo FSRS',
                    'Hơn 9.000+ từ vựng chia sẵn theo chặng ngắn 5–8 phút'
                ],
                ctaText: 'Bắt đầu miễn phí',
                ctaHref: '/auth'
            },
            toeic: {
                badge: 'Lộ trình TOEIC 450 → 850+',
                lead: 'Nắm trọn từ vựng TOEIC.',
                accent: 'Tăng điểm nghe & đọc rõ rệt.',
                sub: 'Hệ thống hóa toàn bộ từ vựng ETS hay bẫy nhất theo từng Part, kết hợp luyện nghe phản xạ và nhắc ôn FSRS.',
                bullets: [
                    'Bộ từ vựng sát đề TOEIC chia theo chủ đề & mục tiêu điểm',
                    'Luyện phát âm IPA & phản xạ nghe tránh bẫy âm gần giống',
                    'Ôn tập 5–8 phút mỗi ngày, không lo học trước quên sau'
                ],
                ctaText: 'Học lộ trình TOEIC',
                ctaHref: '/auth?track=toeic'
            },
            ielts: {
                badge: 'Lộ trình IELTS & THPT Quốc Gia',
                lead: 'Từ học thuật chọn lọc.',
                accent: 'Dùng chuẩn trong bài thi.',
                sub: 'Tập trung vào Academic Vocabulary, Collocations và Paraphrase giúp nâng band Reading, Listening và Writing.',
                bullets: [
                    'Tra từ học thuật trực tiếp khi luyện đọc bài báo & đề thi',
                    'AI giải thích sắc thái nghĩa và cách ghép cụm từ (collocations)',
                    'Theo dõi độ bền trí nhớ từng từ cho đến ngày bước vào phòng thi'
                ],
                ctaText: 'Khám phá lộ trình IELTS',
                ctaHref: '/auth?track=ielts'
            }
        };

        function setActiveLearner(tab) {
            const content = learnerContent[tab];
            if (!content) return;

            document.querySelectorAll('.learner-tab-btn').forEach(btn => {
                if (btn.getAttribute('data-learner-tab') === tab) {
                    btn.className = 'learner-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors bg-[#241710] text-[#f1c46d] cursor-pointer';
                } else {
                    btn.className = 'learner-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors border border-transparent bg-transparent text-[#5e4b40] hover:bg-white cursor-pointer';
                }
            });

            const badgeEl = document.getElementById('learner-badge');
            const leadEl = document.getElementById('learner-lead');
            const accentEl = document.getElementById('learner-accent');
            const subEl = document.getElementById('learner-sub');
            const bulletsEl = document.getElementById('learner-bullets');
            const ctaEl = document.getElementById('learner-cta-primary');
            const ctaTextEl = document.getElementById('learner-cta-text');

            if (badgeEl) badgeEl.textContent = content.badge;
            if (leadEl) leadEl.textContent = content.lead;
            if (accentEl) accentEl.textContent = content.accent;
            if (subEl) subEl.textContent = content.sub;
            if (ctaEl) ctaEl.setAttribute('href', content.ctaHref);
            if (ctaTextEl) ctaTextEl.textContent = content.ctaText;

            if (bulletsEl) {
                bulletsEl.innerHTML = content.bullets.map(b => `
                    <li class="flex items-center gap-3 font-semibold text-[#241710]">
                        <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#b5502f]"></i>
                        <span>${b}</span>
                    </li>
                `).join('');
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }
        }

        let openFaqIndex = null;
        function toggleFaq(index) {
            const nextOpen = openFaqIndex === index ? null : index;
            for (let i = 0; i < 5; i++) {
                const ans = document.getElementById('faq-answer-' + i);
                const icon = document.getElementById('faq-icon-' + i);
                if (i === nextOpen) {
                    ans?.classList.remove('hidden');
                    icon?.classList.add('rotate-180');
                } else {
                    ans?.classList.add('hidden');
                    icon?.classList.remove('rotate-180');
                }
            }
            openFaqIndex = nextOpen;
        }

        (function () {
            var BUILTIN_SAMPLES = {
                resilient: {
                    ipa: 'rɪˈzɪliənt',
                    source: 'Kho từ điển',
                    meanings: [
                        {
                            pos: 'adj',
                            definition: 'Kiên cường, có khả năng phục hồi nhanh sau khó khăn hoặc biến cố',
                            example: 'She remained resilient despite all the setbacks in her career.'
                        },
                        {
                            pos: 'adj',
                            definition: 'Đàn hồi, co giãn tốt (vật liệu, hệ thống)',
                            example: 'Building a resilient supply chain is critical for modern businesses.'
                        }
                    ]
                },
                achieve: {
                    ipa: 'əˈtʃiːv',
                    source: 'Kho từ điển',
                    meanings: [
                        {
                            pos: 'verb',
                            definition: 'Đạt được, giành được (mục tiêu, kết quả sau nỗ lực)',
                            example: 'With consistent daily practice, you can achieve a high TOEIC score.'
                        }
                    ]
                },
                benefit: {
                    ipa: 'ˈbenɪfɪt',
                    source: 'Kho từ điển',
                    meanings: [
                        {
                            pos: 'noun',
                            definition: 'Lợi ích, phúc lợi, quyền lợi',
                            example: 'Regular spaced repetition brings long-term benefits to memory.'
                        },
                        {
                            pos: 'verb',
                            definition: 'Mang lại lợi ích cho, hưởng lợi từ',
                            example: 'Students benefit greatly from contextual examples.'
                        }
                    ]
                },
                environment: {
                    ipa: 'ɪnˈvaɪrənmənt',
                    source: 'Kho từ điển',
                    meanings: [
                        {
                            pos: 'noun',
                            definition: 'Môi trường (tự nhiên hoặc môi trường làm việc, học tập)',
                            example: 'We strive to create a supportive learning environment for everyone.'
                        }
                    ]
                },
                opportunity: {
                    ipa: 'ˌɒpəˈtjuːnəti',
                    source: 'Kho từ điển',
                    meanings: [
                        {
                            pos: 'noun',
                            definition: 'Cơ hội, thời cơ thuận lợi',
                            example: 'Mastering English opens up global career opportunities.'
                        }
                    ]
                }
            };

            var form = document.getElementById('dict-demo-form');
            var input = document.getElementById('dict-demo-input');
            var submitBtn = document.getElementById('dict-demo-submit');
            var searchIcon = document.getElementById('dict-demo-search-icon');
            var spinner = document.getElementById('dict-demo-spinner');
            var hintEl = document.getElementById('dict-demo-hint');
            var loadingEl = document.getElementById('dict-demo-loading');
            var errorEl = document.getElementById('dict-demo-error');
            var errorTextEl = document.getElementById('dict-demo-error-text');
            var resultEl = document.getElementById('dict-demo-result');
            var wordEl = document.getElementById('dict-res-word');
            var sourceEl = document.getElementById('dict-res-source');
            var ipaEl = document.getElementById('dict-res-ipa');
            var meaningsEl = document.getElementById('dict-res-meanings');
            var speakUkBtn = document.getElementById('dict-speak-uk');
            var speakUsBtn = document.getElementById('dict-speak-us');
            var currentWord = '';

            function speakWord(word, lang) {
                if (!word || typeof window.speechSynthesis === 'undefined') return;
                try {
                    window.speechSynthesis.cancel();
                    var utter = new SpeechSynthesisUtterance(word);
                    utter.lang = lang || 'en-US';
                    utter.rate = 1.0;
                    window.speechSynthesis.speak(utter);
                } catch (_) {}
            }

            if (speakUkBtn) {
                speakUkBtn.addEventListener('click', function () { speakWord(currentWord, 'en-GB'); });
            }
            if (speakUsBtn) {
                speakUsBtn.addEventListener('click', function () { speakWord(currentWord, 'en-US'); });
            }

            function setLoadingState(isLoading) {
                if (submitBtn) submitBtn.disabled = isLoading;
                if (searchIcon) searchIcon.style.display = isLoading ? 'none' : 'block';
                if (spinner) spinner.style.display = isLoading ? 'block' : 'none';
                if (loadingEl) loadingEl.style.display = isLoading ? 'flex' : 'none';
                if (isLoading) {
                    if (hintEl) hintEl.style.display = 'none';
                    if (errorEl) errorEl.style.display = 'none';
                    if (resultEl) resultEl.style.display = 'none';
                }
            }

            function renderResult(word, ipa, source, meanings) {
                currentWord = word;
                if (wordEl) wordEl.textContent = word;
                if (sourceEl) sourceEl.textContent = source || 'Kho từ điển';
                if (ipaEl) {
                    if (ipa) {
                        var cleanIpa = ipa.replace(/^\/+|\/+$/g, '');
                        ipaEl.textContent = '/' + cleanIpa + '/';
                        ipaEl.style.display = 'inline-block';
                    } else {
                        ipaEl.style.display = 'none';
                    }
                }
                if (meaningsEl) {
                    meaningsEl.innerHTML = '';
                    (meanings || []).slice(0, 4).forEach(function (m) {
                        var li = document.createElement('li');
                        li.className = 'rounded-xl border border-[#eadfd0] bg-white p-3.5 shadow-2xs';

                        var posSpan = document.createElement('span');
                        posSpan.className = 'mr-2 rounded-md bg-[#b5502f]/12 px-2 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#b5502f]';
                        posSpan.textContent = m.pos || 'word';
                        li.appendChild(posSpan);

                        var defSpan = document.createElement('span');
                        defSpan.className = 'text-sm font-semibold text-[#241710]';
                        defSpan.textContent = m.definition || '';
                        li.appendChild(defSpan);

                        if (m.example) {
                            var exP = document.createElement('p');
                            exP.className = 'mt-1.5 text-xs italic text-[#6d574a]';
                            exP.textContent = '“' + m.example + '”';
                            li.appendChild(exP);
                        }
                        meaningsEl.appendChild(li);
                    });
                }
                if (hintEl) hintEl.style.display = 'none';
                if (errorEl) errorEl.style.display = 'none';
                if (resultEl) resultEl.style.display = 'block';
            }

            function renderError(trimmed) {
                if (errorTextEl) {
                    errorTextEl.textContent = 'Chưa tìm thấy "' + trimmed + '" ở 2 nguồn miễn phí. Đăng ký để dùng AI tra mọi từ.';
                }
                if (hintEl) hintEl.style.display = 'none';
                if (resultEl) resultEl.style.display = 'none';
                if (errorEl) errorEl.style.display = 'block';
            }

            async function lookupWord(rawWord) {
                var trimmed = (rawWord || '').trim().toLowerCase();
                if (!trimmed) return;
                setLoadingState(true);

                // Tier 1: Backend API (/api/v1/dictionary/lookup)
                try {
                    var res = await fetch('/api/v1/dictionary/lookup?term=' + encodeURIComponent(trimmed));
                    if (res.ok) {
                        var payload = await res.json();
                        var entry = payload && payload.data;
                        if (entry && entry.term) {
                            var parsedDefs = [];
                            try {
                                var rawDefs = JSON.parse(entry.definitionsJson || '[]');
                                if (Array.isArray(rawDefs)) {
                                    parsedDefs = rawDefs.map(function (d) {
                                        if (typeof d === 'string') {
                                            return { pos: entry.partOfSpeech || 'word', definition: d };
                                        }
                                        return {
                                            pos: d.pos || entry.partOfSpeech || 'word',
                                            definition: d.definition || d.meaning || d.vi || '',
                                            example: d.example || ''
                                        };
                                    });
                                }
                            } catch (_) {}
                            if (parsedDefs.length > 0) {
                                setLoadingState(false);
                                renderResult(entry.term, entry.ipa, 'Kho từ điển', parsedDefs);
                                return;
                            }
                        }
                    }
                } catch (_) {}

                // Tier 2: Built-in high-speed dictionary sample cache
                if (BUILTIN_SAMPLES[trimmed]) {
                    var sample = BUILTIN_SAMPLES[trimmed];
                    setLoadingState(false);
                    renderResult(trimmed, sample.ipa, sample.source, sample.meanings);
                    return;
                }

                // Tier 3: Public Free Dictionary API fallback
                try {
                    var extRes = await fetch('https://api.dictionaryapi.dev/api/v2/entries/en/' + encodeURIComponent(trimmed));
                    if (extRes.ok) {
                        var extJson = await extRes.json();
                        if (Array.isArray(extJson) && extJson.length > 0) {
                            var first = extJson[0];
                            var ipa = first.phonetic || (first.phonetics && first.phonetics[0] && first.phonetics[0].text) || '';
                            var meanings = [];
                            (first.meanings || []).forEach(function (m) {
                                (m.definitions || []).forEach(function (d) {
                                    if (meanings.length < 4 && d.definition) {
                                        meanings.push({
                                            pos: m.partOfSpeech || 'word',
                                            definition: d.definition,
                                            example: d.example || ''
                                        });
                                    }
                                });
                            });
                            if (meanings.length > 0) {
                                setLoadingState(false);
                                renderResult(trimmed, ipa, 'Wiktionary', meanings);
                                return;
                            }
                        }
                    }
                } catch (_) {}

                setLoadingState(false);
                renderError(trimmed);
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    lookupWord(input ? input.value : '');
                });
            }

            var chips = document.querySelectorAll('.dict-sample-chip');
            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    var w = chip.getAttribute('data-sample-word') || '';
                    if (input) input.value = w;
                    lookupWord(w);
                });
            });
        })();
    </script>
</body>
</html>
