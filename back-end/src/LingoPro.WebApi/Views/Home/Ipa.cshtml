@using System.Text.Json
@using LingoPro.WebApi.Services.Ipa
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    ViewData["ActiveNav"] = "ipa";

    const string baseUrl = "https://lingopro.online";
    const string pageUrl = baseUrl + "/ipa";
    const string pageTitle = "Bảng Phiên Âm IPA Chuẩn Quốc Tế (44 Âm) | Học Phát Âm Tiếng Anh Mỹ - LingoPro";
    const string metaDesc = "Lộ trình làm chủ 44 âm phiên âm IPA tiếng Anh chuẩn quốc tế cho người Việt. Video thị phạm khẩu hình môi-răng-lưỡi từ Rachel's English, 4 chặng sư phạm trọng tâm sửa âm tử huyệt, bài tập 5 bước chuẩn khoa học.";
    const string keywords = "bảng phiên âm ipa, 44 âm ipa tiếng anh, bảng ipa tiếng anh, học phát âm ipa, phát âm tiếng anh chuẩn mỹ, nguyên âm phụ âm tiếng anh, rachel english ipa, phát âm tiếng anh cho người việt, cách đọc bảng ipa, tử huyệt phát âm tiếng anh, luyện phát âm ipa online, ipa soundboard";
    const string ogTitle = "Bảng Phiên Âm IPA Chuẩn Quốc Tế (44 Âm) — LingoPro";
    const string ogDesc = "Lộ trình 4 chặng làm chủ 44 âm IPA tiếng Anh với video khẩu hình chuẩn Rachel's English. Miễn phí thực hành phản xạ cho người Việt.";
    const string twDesc = "Làm chủ 44 âm IPA tiếng Anh với video khẩu hình chuẩn Rachel's English theo lộ trình 4 chặng sư phạm.";

    var web = Env.WebRootPath ?? System.IO.Path.Combine(AppContext.BaseDirectory, "wwwroot");
    var chart = IpaChart.Get(web);
    var phonemes = chart.Phonemes;
    var stages = IpaStages.All;
    var firstRecommended = IpaChart.FindById(web, IpaStages.DefaultRecommendedId) ?? phonemes.FirstOrDefault();

    // Active stage from ?stage= (the JS keeps it in sync); defaults to stage 1.
    var requestedStage = Context.Request.Query["stage"].ToString();
    var activeStageId = stages.Any(s => s.Id == requestedStage) ? requestedStage : IpaStages.DefaultStageId;

    // JSON-LD graph (ported from src/app/ipa/layout.tsx).
    var jsonLd = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@graph"] = new object[]
        {
            new Dictionary<string, object>
            {
                ["@type"] = "Course",
                ["name"] = "Luyện Phát Âm Tiếng Anh Chuẩn 44 Âm Phiên Âm IPA Quốc Tế",
                ["description"] = "Khóa học và bảng âm tương tác 44 âm IPA chuẩn Anh - Mỹ với video thị phạm khẩu hình từ Rachel's English, phân chia 4 chặng sư phạm chuyên sâu cho người Việt.",
                ["provider"] = new Dictionary<string, object>
                {
                    ["@type"] = "Organization",
                    ["name"] = "LingoPro",
                    ["url"] = baseUrl,
                },
                ["educationalLevel"] = "Beginner to Advanced",
                ["inLanguage"] = "vi",
                ["hasCourseInstance"] = new Dictionary<string, object>
                {
                    ["@type"] = "CourseInstance",
                    ["courseMode"] = "online",
                    ["courseWorkload"] = "PT15M",
                },
            },
            new Dictionary<string, object>
            {
                ["@type"] = "LearningResource",
                ["name"] = "Bảng Tương Tác Phiên Âm IPA 44 Âm Quốc Tế",
                ["description"] = "Hệ thống soundboard luyện nghe, xem video khẩu hình phân đoạn và luyện phân biệt cặp âm tối thiểu (minimal pairs).",
                ["url"] = pageUrl,
                ["learningResourceType"] = "Interactive Resource",
                ["educationalUse"] = "Pronunciation practice",
                ["inLanguage"] = "vi",
            },
            new Dictionary<string, object>
            {
                ["@type"] = "BreadcrumbList",
                ["itemListElement"] = new object[]
                {
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Trang chủ", ["item"] = baseUrl },
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "Lộ trình", ["item"] = baseUrl + "/journey" },
                    new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = "Phiên Âm IPA", ["item"] = pageUrl },
                },
            },
            new Dictionary<string, object>
            {
                ["@type"] = "FAQPage",
                ["mainEntity"] = new object[]
                {
                    Faq("Bảng phiên âm IPA tiếng Anh có bao nhiêu âm và gồm những nhóm nào?",
                        "Bảng phiên âm IPA tiếng Anh quốc tế gồm đúng 44 âm, chia thành: 12 nguyên âm đơn (Monophthongs), 8 nguyên âm đôi (Diphthongs) và 24 phụ âm (Consonants)."),
                    Faq("Người Việt hay phát âm sai những âm nào nhất trong tiếng Anh?",
                        "Người Việt hay gặp khó khăn nhất ở 14 âm: ngọng hai âm th (/θ/ và /ð/), nuốt âm gió và âm đuôi (/s/, /z/, /t/, /k/), âm chu môi (/ʃ/, /ʒ/, /tʃ/, /dʒ/), cắn môi dưới (/v/), và nhầm lẫn giữa nguyên âm dài và ngắn (/iː/ vs /ɪ/)."),
                    Faq("Tại sao LingoPro lại chia lộ trình thành 4 chặng học?",
                        "Để tránh quá tải nhận thức khi nhìn vào 44 âm cùng lúc. Chặng 1 sửa 14 âm tử huyệt người Việt hay sai; Chặng 2 luyện các cặp nguyên âm đối lập dài/ngắn; Chặng 3 học 8 cặp phụ âm đối xứng cùng khẩu hình (học 1 được 2); Chặng 4 hoàn thiện âm đôi và âm lướt để nói trôi chảy."),
                    Faq("Học phát âm IPA trên LingoPro có mất phí không?",
                        "Bảng phiên âm IPA và toàn bộ bài tập luyện khẩu hình, nghe mẫu và video Rachel's English trên LingoPro là hoàn toàn miễn phí trên nền tảng web."),
                },
            },
        },
    };
    var jsonLdText = JsonSerializer.Serialize(jsonLd);

    // Single data blob consumed by wwwroot/js/ipa-studio.js.
    var dataBlob = JsonSerializer.Serialize(new { phonemes, stages }, IpaChart.JsonOptions);

    static Dictionary<string, object> Faq(string question, string answer) => new()
    {
        ["@type"] = "Question",
        ["name"] = question,
        ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = answer },
    };

    // FAQ entries rendered in the visible accordion: icon, border colour, question, answer HTML.
    var faqItems = new (string Icon, string Border, string Question, string AnswerHtml)[]
    {
        ("📌", "border-[#b5502f]/40",
            "Bảng phiên âm IPA tiếng Anh là gì và vì sao người học cần làm chủ trước tiên?",
            "Khác với tiếng Việt (chữ viết sao đọc vậy), tiếng Anh có độ lệch rất lớn giữa mặt chữ và phát âm (ví dụ: chữ &quot;a&quot; trong <em>cat</em>, <em>car</em>, <em>about</em>, <em>water</em> phát âm hoàn toàn khác nhau). <strong>Bảng Ký Hiệu Ngữ Âm Quốc Tế (IPA - International Phonetic Alphabet)</strong> gồm đúng 44 âm chuẩn, giúp bạn nhìn vào phiên âm trong từ điển là đọc chính xác 100% bất kỳ từ nào mà không cần đoán mò."),
        ("🔴", "border-amber-500/40",
            "Vì sao người Việt hay nói ngọng tiếng Anh và 14 âm &quot;tử huyệt&quot; gồm những âm nào?",
            "Người Việt gặp khó khăn do thói quen cấu âm tiếng mẹ đẻ: tiếng Việt không có âm xát răng môi, không bật âm đuôi và không có nguyên âm căng/thả lỏng. 14 âm gây hiểu lầm tai hại nhất gồm: âm thè lưỡi thổi gió <strong>/θ/</strong> (<em>think</em>) và thè lưỡi rung cổ <strong>/ð/</strong> (<em>this</em>); nuốt âm đuôi <strong>/s/</strong>, <strong>/z/</strong>, <strong>/t/</strong>, <strong>/k/</strong>; âm chu môi <strong>/ʃ/</strong>, <strong>/ʒ/</strong>, <strong>/tʃ/</strong>, <strong>/dʒ/</strong>; cắn môi dưới <strong>/v/</strong>; và nhầm lẫn cặp nguyên âm <strong>/iː/</strong> (sheep) với <strong>/ɪ/</strong> (ship)."),
        ("⚖️", "border-blue-500/40",
            "Bí quyết phân biệt Cặp Nguyên Âm Đối Lập: Dài (Tense) ↔ Ngắn (Lax)",
            "Đừng hiểu lầm &quot;âm dài chỉ đơn thuần là đọc kéo dài thời gian&quot;. Điểm mấu chốt nằm ở <strong>độ căng của cơ mặt</strong>: với âm dài (như /iː/, /uː/, /ɔː/), khóe miệng và lưỡi phải kéo căng (Tense); còn với âm ngắn (như /ɪ/, /ʊ/, /ɒ/), toàn bộ cơ miệng và quai hàm hoàn toàn thả lỏng (Lax) và dứt khoát."),
        ("🗣️", "border-emerald-500/40",
            "Quy luật đối xứng của 8 Cặp Phụ Âm (Học 1 được 2): Vô thanh ↔ Hữu thanh",
            "Tiết kiệm 50% công sức bằng cách nhớ rằng mỗi cặp phụ âm có <strong>cùng một vị trí cơ môi - răng - lưỡi</strong>. Khi đọc âm <strong>Vô thanh</strong> (/p/, /t/, /k/, /f/, /θ/, /s/, /ʃ/, /tʃ/), dây thanh quản không rung, bạn chỉ thổi luồng hơi ra ngoài. Khi chuyển sang âm <strong>Hữu thanh</strong> (/b/, /d/, /g/, /v/, /ð/, /z/, /ʒ/, /dʒ/), giữ nguyên khẩu hình miệng và làm rung cổ họng."),
        ("🎥", "border-purple-500/40",
            "Video thị phạm khẩu hình trên LingoPro có nguồn gốc từ đâu?",
            "100% video khẩu hình được tuyển chọn đồng nhất từ kênh <strong>Rachel's English</strong> — kênh giảng dạy ngữ âm tiếng Anh - Mỹ uy tín hàng đầu thế giới. LingoPro đã cắt lọc chính xác các mốc giây quay cận cảnh môi, hàm, răng và góc cắt giải phẫu vòm miệng giúp học viên quan sát trực quan nhất."),
    };

    var monophthongs = phonemes.Where(p => p.Type == "monophthong").ToList();
    var diphthongs = phonemes.Where(p => p.Type == "diphthong").ToList();
    var consonants = phonemes.Where(p => p.Type == "consonant").ToList();
}
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
    <meta name="theme-color" content="#241710" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta name="keywords" content="@keywords" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@pageUrl" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="LingoPro" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:url" content="@pageUrl" />
    <meta property="og:image" content="@(baseUrl)/opengraph-image" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bảng Phiên Âm IPA Quốc Tế 44 Âm LingoPro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@twDesc" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>

    <script type="application/ld+json">@Html.Raw(jsonLdText)</script>

    <style>
        html, body { font-family: 'Be Vietnam Pro', 'Inter', system-ui, -apple-system, sans-serif; }
        summary::-webkit-details-marker { display: none; }
        details[open] .faq-caret { transform: rotate(180deg); }
        .ipa-card[data-mastered="true"] { border-color: rgb(16 185 129 / .5); background-color: rgb(16 185 129 / .08); }
        .ipa-card[data-hard="true"]:not([data-mastered="true"]) { border-color: rgb(251 191 36 / .55); }
        body.ipa-modal-open { overflow: hidden; }
    </style>
</head>
<body class="min-h-dvh overflow-x-hidden bg-[#f6efe6] text-[#241710] antialiased">
    <partial name="_MarketingHeader" />

    <main id="ipa-root" data-active-stage="@activeStageId" class="mx-auto max-w-6xl space-y-4 p-4 pb-20 sm:space-y-5 sm:p-6">
        <!-- Header block -->
        <div class="flex flex-col justify-between gap-3 border-b border-[#bca58f]/40 pb-3 sm:flex-row sm:items-center">
            <div>
                <div class="mb-0.5 flex items-center gap-2 text-xs">
                    <a href="/auth/login?returnUrl=%2Fapp" class="flex items-center gap-1 text-[#241710]/60 transition hover:text-[#241710]">← Lộ trình</a>
                    <span class="text-[#241710]/40">/</span>
                    <span class="font-semibold text-[#b5502f]">Phiên Âm IPA</span>
                </div>
                <h1 class="flex flex-wrap items-center gap-2 text-xl font-black tracking-tight sm:text-2xl">
                    <span>Phiên Âm IPA</span>
                    <span class="rounded-full border border-[#b5502f]/25 bg-[#b5502f]/10 px-2 py-0.5 text-xs font-semibold text-[#b5502f]">44 Âm Quốc Tế</span>
                </h1>
                <p class="mt-0.5 text-xs text-[#241710]/60">Làm chủ khẩu hình môi - răng - lưỡi với video chuẩn từ Rachel's English</p>
            </div>
            <div class="flex shrink-0 items-center gap-3">
                <div class="flex items-center gap-2 rounded-xl border border-[#bca58f]/50 bg-white/60 px-3 py-1.5 text-xs">
                    <span class="text-base">🏆</span>
                    <div class="space-y-0.5">
                        <div class="flex items-center justify-between gap-3 text-[11px]">
                            <span class="text-[#241710]/60">Đã nắm:</span>
                            <span class="font-mono font-bold" id="ipa-mastered-count">0/@phonemes.Count</span>
                        </div>
                        <div class="h-1.5 w-24 overflow-hidden rounded-full bg-[#bca58f]/30">
                            <div id="ipa-mastered-bar" class="h-full rounded-full bg-emerald-500 transition-all duration-300" style="width:0%"></div>
                        </div>
                    </div>
                    <span id="ipa-mastered-percent" class="ml-1 font-mono text-[11px] font-bold text-emerald-600">0%</span>
                </div>
                <a href="/auth/login?returnUrl=%2Fapp" class="inline-flex h-8 items-center rounded-xl border border-[#bca58f]/60 px-3 text-xs font-semibold transition hover:bg-white">Lộ trình</a>
            </div>
        </div>

        <!-- Coach card -->
        <section class="relative overflow-hidden rounded-2xl border border-[#b5502f]/25 bg-gradient-to-r from-[#fbe9dc] via-[#f9efe4] to-[#f6efe6] p-4 shadow-sm">
            <div class="flex flex-col justify-between gap-3.5 md:flex-row md:items-center">
                <div class="flex max-w-2xl items-start gap-3">
                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#b5502f] text-base text-white shadow-sm">🎙️</div>
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-[#241710]">Huấn luyện viên phát âm LingoPro</span>
                            <span class="rounded-full bg-[#b5502f]/15 px-2 py-0.5 text-[10px] font-semibold text-[#b5502f]">Ân cần · Từng bước</span>
                        </div>
                        <p class="text-xs leading-relaxed text-[#241710]/80">
                            Đừng cố học thuộc cả 44 âm trong một lần nhé! Hãy rèn luyện từng bước theo <strong>4 Chặng khoa học</strong> dưới đây: bắt đầu từ 14 âm người Việt hay nói ngọng nhất, rồi học các cặp âm cùng khẩu hình để nhớ lâu gấp đôi.
                        </p>
                    </div>
                </div>
                @if (firstRecommended is not null)
                {
                    <div class="flex shrink-0 items-center justify-between gap-2.5 border-t border-[#bca58f]/30 pt-2.5 md:justify-end md:border-t-0 md:pt-0">
                        <div class="hidden text-right sm:block">
                            <div class="text-[10px] text-[#241710]/60">Âm đề xuất hôm nay</div>
                            <div class="text-xs font-bold" id="ipa-next-label">/@firstRecommended.Symbol/ · @firstRecommended.AnchorWord</div>
                        </div>
                        <button type="button" id="ipa-next-btn" data-ipa-open="@firstRecommended.Id" class="inline-flex h-9 items-center gap-1.5 rounded-xl bg-[#b5502f] px-3.5 text-xs font-bold text-white shadow-sm transition hover:bg-[#9c4326]">
                            <span id="ipa-next-btn-text">🎯 Luyện ngay /@firstRecommended.Symbol/</span> →
                        </button>
                    </div>
                }
            </div>
        </section>

        <!-- Soundboard -->
        <section id="ipa-soundboard" class="space-y-4" aria-label="Bảng âm IPA tương tác">
            <div class="flex flex-col justify-between gap-3 pb-1 sm:flex-row sm:items-center">
                <div class="js-only hidden items-center self-start rounded-xl border border-[#bca58f]/50 bg-white/50 p-1 text-xs">
                    <button type="button" data-ipa-mode="pathway" class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-semibold transition">
                        <span>🧭 Lộ trình 4 Chặng</span>
                        <span class="rounded-full bg-[#b5502f]/10 px-1.5 py-0.5 text-[9px] font-bold text-[#b5502f]">Khuyên dùng</span>
                    </button>
                    <button type="button" data-ipa-mode="reference" class="flex items-center gap-1.5 rounded-lg px-3 py-1.5 font-semibold transition">🗂️ Bảng tra cứu 44 âm</button>
                </div>
                <div id="ipa-stage-progress" class="flex items-center gap-2 text-xs text-[#241710]/60">
                    <span>Tiến độ chặng hiện tại:</span>
                    <span class="font-mono font-bold text-[#241710]" id="ipa-stage-count">0/0</span>
                    <div class="inline-block h-1.5 w-16 overflow-hidden rounded-full bg-[#bca58f]/30"><div id="ipa-stage-bar" class="h-full rounded-full bg-emerald-500 transition-all" style="width:0%"></div></div>
                    <span class="font-mono text-[11px] font-semibold text-emerald-600" id="ipa-stage-percent">0%</span>
                </div>
            </div>

            <div id="ipa-pathway" class="space-y-4">
                <!-- Stage tabs (plain links so they also work without JS) -->
                <nav class="grid grid-cols-2 gap-2 sm:grid-cols-4" aria-label="4 chặng học">
                    @foreach (var s in stages)
                    {
                        <a href="?stage=@s.Id" data-ipa-stage="@s.Id" class="relative flex flex-col justify-between overflow-hidden rounded-xl border border-[#bca58f]/50 bg-white/60 p-3 text-left transition hover:bg-white">
                            <div class="mb-1 flex items-center justify-between gap-1">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-[#241710]/60">Chặng @s.StageNumber</span>
                                <span class="rounded-full bg-[#bca58f]/20 px-1.5 py-0.5 text-[9px] font-semibold text-[#241710]/70">@s.Badge</span>
                            </div>
                            <div class="line-clamp-1 text-xs font-bold">@s.ShortTitle</div>
                            <div class="mt-2 flex items-center justify-between text-[10px] text-[#241710]/60">
                                <span><span data-ipa-stage-mastered="@s.Id">0</span>/@s.PhonemeIds.Count âm</span>
                                <span class="font-mono font-semibold" data-ipa-stage-percent="@s.Id">0%</span>
                            </div>
                            <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-[#bca58f]/30"><div class="h-full rounded-full bg-[#b5502f] transition-all" data-ipa-stage-bar="@s.Id" style="width:0%"></div></div>
                        </a>
                    }
                </nav>

                @foreach (var s in stages)
                {
                    var stagePhonemes = IpaChart.ForStage(web, s);
                    <div data-ipa-panel="@s.Id" id="@s.Id" class="space-y-4">
                        <div class="space-y-3 rounded-2xl border border-[#b5502f]/20 bg-white/50 p-4 sm:p-5">
                            <div class="flex flex-col justify-between gap-2 border-b border-[#bca58f]/40 pb-3 sm:flex-row sm:items-center">
                                <div class="flex items-center gap-2">
                                    <span class="rounded-md bg-[#b5502f] px-2 py-0.5 text-xs font-bold text-white">Chặng @s.StageNumber</span>
                                    <h2 class="text-base font-black tracking-tight sm:text-lg">@s.Title</h2>
                                </div>
                                <span class="text-xs text-[#241710]/60">Tổng số: <strong class="text-[#241710]">@s.PhonemeIds.Count âm</strong></span>
                            </div>
                            <div class="grid grid-cols-1 gap-3 text-xs md:grid-cols-2">
                                <div class="flex items-start gap-2.5 rounded-xl border border-[#bca58f]/40 bg-white/70 p-3">
                                    <span class="shrink-0 text-base">👩‍🏫</span>
                                    <div class="space-y-1">
                                        <span class="font-bold">Lời dặn của giáo viên:</span>
                                        <p class="leading-relaxed text-[#241710]/70">@s.CoachNote</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-2.5 rounded-xl border border-amber-300/50 bg-amber-500/5 p-3">
                                    <span class="mt-0.5 shrink-0 text-base">💡</span>
                                    <div class="space-y-1">
                                        <span class="font-bold text-amber-800">Mẹo thực hành then chốt:</span>
                                        <p class="leading-relaxed text-amber-900/80">@s.PedagogicalTip</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (s.Id == "stage-must-fix")
                        {
                            <div class="space-y-3">
                                <div class="flex items-center justify-between px-1 text-xs text-[#241710]/60">
                                    <span>14 âm cấp bách cần sửa ngay để tránh nói ngọng:</span>
                                    <span class="text-[11px] italic">Bấm vào từng âm để vào phòng luyện video</span>
                                </div>
                                <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 md:grid-cols-4 lg:grid-cols-7">
                                    @foreach (var p in stagePhonemes)
                                    {
                                        <partial name="~/Views/Shared/Ipa/_PhonemeCard.cshtml" model="p" />
                                    }
                                </div>
                            </div>
                        }
                        else if (s.Pairs is { Count: > 0 })
                        {
                            <div class="space-y-3">
                                <div class="flex items-center justify-between px-1 text-xs text-[#241710]/60">
                                    <span>
                                        @(s.Id == "stage-vowel-pairs"
                                            ? "6 Cặp nguyên âm đối lập (Âm Dài cơ miệng CĂNG ↔ Âm Ngắn cơ miệng THẢ LỎNG):"
                                            : "8 Cặp phụ âm đối xứng (CÙNG 1 KHẨU HÌNH: Vô thanh chỉ xì gió ↔ Hữu thanh rung cổ họng):")
                                    </span>
                                    <span class="text-[11px] italic">Bấm vào từng âm để luyện</span>
                                </div>
                                <div class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2">
                                    @for (var i = 0; i < s.Pairs.Count; i++)
                                    {
                                        var pair = s.Pairs[i];
                                        var first = IpaChart.FindById(web, pair.Phoneme1Id);
                                        var second = IpaChart.FindById(web, pair.Phoneme2Id);
                                        if (first is null || second is null) { continue; }
                                        <partial name="~/Views/Shared/Ipa/_PairCard.cshtml" model="new IpaPairView(pair, first, second, i)" />
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="space-y-5">
                                <div class="space-y-2.5">
                                    <h3 class="flex items-center gap-2 border-b border-[#bca58f]/40 pb-1.5 text-xs font-bold">
                                        <span class="inline-block h-2.5 w-2.5 rounded-full bg-purple-500"></span>
                                        8 Nguyên âm đôi (Diphthongs) · Lướt mượt từ âm 1 sang âm 2
                                    </h3>
                                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4 sm:gap-3">
                                        @foreach (var p in stagePhonemes.Where(x => x.Type == "diphthong"))
                                        {
                                            <partial name="~/Views/Shared/Ipa/_PhonemeCard.cshtml" model="p" />
                                        }
                                    </div>
                                </div>
                                <div class="space-y-2.5">
                                    <h3 class="flex items-center gap-2 border-b border-[#bca58f]/40 pb-1.5 text-xs font-bold">
                                        <span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                                        8 Phụ âm mũi &amp; Âm lướt (Sonorants &amp; Glides) · Giúp nối từ và ngữ điệu trôi chảy
                                    </h3>
                                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4 sm:gap-3">
                                        @foreach (var p in stagePhonemes.Where(x => x.Type == "consonant"))
                                        {
                                            <partial name="~/Views/Shared/Ipa/_PhonemeCard.cshtml" model="p" />
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Reference table: all 44 phonemes grouped by type -->
            <div id="ipa-reference" class="space-y-5">
                <div class="js-only hidden w-fit max-w-full items-center gap-1 overflow-x-auto rounded-xl border border-[#bca58f]/50 bg-white/50 p-1">
                    <button type="button" data-ipa-filter="all" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold">Tất cả (@phonemes.Count)</button>
                    <button type="button" data-ipa-filter="vn-hardest" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold text-amber-700">🔥 Hay sai (@(phonemes.Count(p => p.DifficultyForVn == "high")))</button>
                    <button type="button" data-ipa-filter="monophthong" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold">Nguyên âm đơn (@monophthongs.Count)</button>
                    <button type="button" data-ipa-filter="diphthong" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold">Nguyên âm đôi (@diphthongs.Count)</button>
                    <button type="button" data-ipa-filter="consonant" class="whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold">Phụ âm (@consonants.Count)</button>
                </div>
                <h2 class="text-sm font-black tracking-tight sm:text-base">Bảng tra cứu 44 âm IPA tiếng Anh</h2>

                <div data-ipa-group="monophthong" class="space-y-2.5">
                    <div class="flex items-center justify-between border-b border-[#bca58f]/40 pb-1.5">
                        <h3 class="flex items-center gap-2 text-sm font-bold"><span class="inline-block h-2.5 w-2.5 rounded-full bg-blue-500"></span>Nguyên âm đơn (Monophthongs · @monophthongs.Count âm)</h3>
                        <span class="text-[11px] font-medium text-[#241710]/60">Âm dài / ngắn</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 md:grid-cols-4 lg:grid-cols-6">
                        @foreach (var p in monophthongs)
                        {
                            <partial name="~/Views/Shared/Ipa/_PhonemeCard.cshtml" model="p" />
                        }
                    </div>
                </div>
                <div data-ipa-group="diphthong" class="space-y-2.5">
                    <div class="flex items-center justify-between border-b border-[#bca58f]/40 pb-1.5">
                        <h3 class="flex items-center gap-2 text-sm font-bold"><span class="inline-block h-2.5 w-2.5 rounded-full bg-purple-500"></span>Nguyên âm đôi (Diphthongs · @diphthongs.Count âm)</h3>
                        <span class="text-[11px] font-medium text-[#241710]/60">Lướt 2 âm</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 md:grid-cols-4">
                        @foreach (var p in diphthongs)
                        {
                            <partial name="~/Views/Shared/Ipa/_PhonemeCard.cshtml" model="p" />
                        }
                    </div>
                </div>
                <div data-ipa-group="consonant" class="space-y-2.5">
                    <div class="flex items-center justify-between border-b border-[#bca58f]/40 pb-1.5">
                        <h3 class="flex items-center gap-2 text-sm font-bold"><span class="inline-block h-2.5 w-2.5 rounded-full bg-emerald-500"></span>Phụ âm (Consonants · @consonants.Count âm)</h3>
                        <span class="text-[11px] font-medium text-[#241710]/60">Vô thanh ↔ Hữu thanh</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-3 md:grid-cols-4 lg:grid-cols-6">
                        @foreach (var p in consonants)
                        {
                            <partial name="~/Views/Shared/Ipa/_PhonemeCard.cshtml" model="p" />
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="mt-8 space-y-4 border-t border-[#bca58f]/40 pt-6">
            <div class="flex flex-col justify-between gap-1 sm:flex-row sm:items-center">
                <div>
                    <h2 class="text-sm font-black tracking-tight sm:text-base">💡 Cẩm Nang &amp; Hỏi Đáp Phát Âm 44 Âm IPA</h2>
                    <p class="mt-0.5 text-xs text-[#241710]/60">Kiến thức ngữ âm cốt lõi giúp người Việt vượt qua các rào cản phát âm phổ biến</p>
                </div>
                <span class="self-start text-[11px] font-medium text-[#241710]/60 sm:self-auto">Nhấp vào câu hỏi để xem chi tiết</span>
            </div>
            <div class="space-y-2">
                @foreach (var f in faqItems)
                {
                    <details class="group cursor-pointer rounded-xl border border-[#bca58f]/50 bg-white/70 p-3 text-xs transition sm:p-3.5">
                        <summary class="flex select-none items-center justify-between font-bold transition hover:text-[#b5502f]">
                            <span class="flex items-center gap-2"><span class="text-base">@f.Icon</span>@Html.Raw(f.Question)</span>
                            <span class="faq-caret ml-2 shrink-0 text-sm text-[#241710]/60 transition-transform">▾</span>
                        </summary>
                        <p class="ml-2 mt-2 border-l-2 @f.Border pl-6 pt-1 leading-relaxed text-[#241710]/70">@Html.Raw(f.AnswerHtml)</p>
                    </details>
                }
            </div>
        </section>
    </main>

    <!-- 5-stage practice studio modal (content built by ipa-studio.js) -->
    <div id="ipa-modal" class="fixed inset-0 z-[60] hidden items-center justify-center overflow-y-auto bg-[#241710]/50 p-3 backdrop-blur-sm sm:p-4" role="dialog" aria-modal="true" aria-label="Phòng luyện phát âm"></div>

    <script type="application/json" id="ipa-data">@Html.Raw(dataBlob)</script>
    <script src="/js/ipa-studio.js" defer></script>
</body>
</html>
