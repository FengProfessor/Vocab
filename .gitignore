# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/tmp/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# scraper artifacts (không commit checkpoint, deck, file PDF nguồn)
scripts/scrapers/.checkpoints/
scripts/scrapers/decks/
*.checkpoint.json
*.apkg

# scraper run logs & debug output (artifact, không commit)
*.log
scraper-*.txt

# local one-off debug scripts (không phải app, không commit)
/scratch/
/.claude/
/check-db.ts
/check_grammar_tables.js
/extract-pdf-content.ts
/extract-pdf-text.ts
/verify_env.js

# One-off local artifacts
/public/icons/icon-email.png
tmp-*
tampermonkey-*
inspect_all_columns.js

# Chrome bot profiles (auto-chrome-bot)
.chrome-bot-profiles/
