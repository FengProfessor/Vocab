@{
    Layout = null;

    const string pageTitle = "Phần mềm quản lý lớp tiếng Anh cho giáo viên | LingoPro";
    const string pageDescription = "Dashboard lớp, giao từ vựng & ngữ pháp, nhắc ôn FSRS tự động. Tiết kiệm 2–4 giờ/tuần soạn bài và chấm. Dùng thử miễn phí cho gia sư, GV, trung tâm.";
    const string canonicalUrl = "https://lingopro.online/for-teachers";
}
<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <meta name="keywords" content="phần mềm quản lý lớp học tiếng Anh, app học từ vựng cho học sinh, dashboard giáo viên tiếng Anh, FSRS, học từ vựng AI, phần mềm giáo viên tiếng Anh, theo dõi tiến độ học sinh" />
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- OpenGraph -->
    <meta property="og:title" content="LingoPro cho Giáo viên &amp; Trung tâm — Dashboard lớp + FSRS" />
    <meta property="og:description" content="Quản lý lớp, giao bài, phát hiện học sinh hụt nhịp. Giảm 2–4 giờ soạn &amp; chấm mỗi tuần." />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="LingoPro" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content="website" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS v4 Browser Runtime -->
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@@latest"></script>

    <style>
        body {
            font-family: 'Be Vietnam Pro', system-ui, -apple-system, sans-serif;
        }
        .pilot-input {
            width: 100%;
            border: 1px solid rgb(255 255 255 / 12%);
            border-radius: 0.875rem;
            background: rgb(255 255 255 / 7%);
            padding: 0.75rem 0.875rem;
            color: white;
            outline: none;
        }
        .pilot-input:focus {
            border-color: #d7ff64;
            box-shadow: 0 0 0 3px rgb(215 255 100 / 12%);
        }
    </style>

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "LingoPro for Teachers",
          "applicationCategory": "EducationalApplication",
          "operatingSystem": "Web",
          "url": "https://lingopro.online/for-teachers",
          "description": "Phần mềm quản lý lớp tiếng Anh: dashboard tiến độ, giao từ vựng, nhắc ôn FSRS, AI hỗ trợ giáo viên.",
          "inLanguage": "vi",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "VND",
            "description": "Tạo lớp miễn phí — báo giá gói trả phí theo quy mô (liên hệ)"
          }
        },
        {
          "@@type": "VideoObject",
          "name": "Demo quy trình giáo viên LingoPro",
          "description": "Tạo lớp, mời học sinh, giao bài, theo dõi tiến độ và phát hiện học sinh cần hỗ trợ.",
          "contentUrl": "https://lingopro.online/lingopro-teacher-flow.mp4",
          "embedUrl": "https://lingopro.online/for-teachers#demo",
          "uploadDate": "2026-06-01",
          "inLanguage": "vi"
        },
        {
          "@@type": "VideoObject",
          "name": "LingoPro vs Anki Quizlet Duolingo cho lớp học",
          "description": "So sánh LingoPro với Anki, Quizlet, Duolingo trong bối cảnh giáo viên quản lý lớp.",
          "contentUrl": "https://lingopro.online/lingopro-vs-anki.mp4",
          "embedUrl": "https://lingopro.online/for-teachers#demo",
          "uploadDate": "2026-06-01",
          "inLanguage": "vi"
        }
      ]
    }
    </script>
</head>
<body class="min-h-dvh overflow-x-hidden bg-[#f7f8f2] text-[#17231d]">
    <div class="min-h-dvh overflow-hidden bg-[#f7f8f2] text-[#17231d]">
        <!-- 1. Header sticky -->
        <header class="sticky top-0 z-50 border-b border-[#17231d]/10 bg-[#f7f8f2]/90 backdrop-blur-xl">
            <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
                <a href="/" class="flex items-center gap-2.5 font-black tracking-tight">
                    <span class="flex size-9 items-center justify-center rounded-xl bg-[#17231d] text-[#d7ff64]">
                        <i data-lucide="brain" class="size-5"></i>
                    </span>
                    LingoPro
                </a>
                <nav class="hidden items-center gap-7 text-sm font-semibold text-[#526057] md:flex">
                    <a href="#giai-phap" class="transition-colors hover:text-[#17231d]">Giải pháp</a>
                    <a href="#tinh-nang" class="transition-colors hover:text-[#17231d]">Tính năng</a>
                    <a href="#demo" class="transition-colors hover:text-[#17231d]">Demo</a>
                    <a href="#bang-gia" class="transition-colors hover:text-[#17231d]">Gói &amp; báo giá</a>
                    <a href="#faq" class="transition-colors hover:text-[#17231d]">FAQ</a>
                </nav>
                <a href="/auth?mode=signup&amp;role=teacher&amp;pilot=teacher_pro"
                   onclick="trackPilotCta('teacher_pro', 'header')"
                   class="inline-flex items-center gap-2 rounded-full bg-[#17231d] px-4 py-2.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5">
                    Tạo lớp miễn phí <i data-lucide="arrow-right" class="size-4"></i>
                </a>
            </div>
        </header>

        <main>
            <!-- 2. Hero + AudienceTabs -->
            <section class="relative px-4 pb-20 pt-16 sm:px-6 sm:pb-28 sm:pt-24">
                <div class="pointer-events-none absolute -right-32 top-0 size-[32rem] rounded-full bg-[#d7ff64]/35 blur-3xl"></div>
                <div class="pointer-events-none absolute -left-48 bottom-0 size-96 rounded-full bg-[#74cbb2]/20 blur-3xl"></div>
                <div class="relative mx-auto grid max-w-7xl items-start gap-14 lg:grid-cols-[1.08fr_0.92fr]">
                    <!-- AudienceTabs -->
                    <div>
                        <div class="flex w-full rounded-full border border-gray-200 bg-white/80 p-1.5 backdrop-blur-sm sm:max-w-md">
                            <button type="button"
                                    data-audience-tab="tutor"
                                    onclick="setActiveAudience('tutor')"
                                    class="audience-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors bg-[#17231d] text-[#d7ff64] cursor-pointer">
                                Gia sư
                            </button>
                            <button type="button"
                                    data-audience-tab="teacher"
                                    onclick="setActiveAudience('teacher')"
                                    class="audience-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors border border-transparent bg-transparent text-[#526057] hover:bg-white cursor-pointer">
                                Giáo viên
                            </button>
                            <button type="button"
                                    data-audience-tab="center"
                                    onclick="setActiveAudience('center')"
                                    class="audience-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors border border-transparent bg-transparent text-[#526057] hover:bg-white cursor-pointer">
                                Trung tâm
                            </button>
                        </div>

                        <div class="mt-8">
                            <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#17231d]/10 bg-white/70 px-4 py-2 text-xs font-black uppercase tracking-[0.16em] text-[#526057]">
                                <i data-lucide="sparkles" class="size-4 text-[#567600]"></i>
                                <span id="audience-badge">Cho gia sư 1:1 &amp; nhóm nhỏ</span>
                            </div>
                            <h1 class="max-w-4xl text-5xl font-black leading-[0.98] tracking-[-0.055em] sm:text-7xl">
                                <span id="audience-lead">Dạy sát từng em.</span>
                                <span id="audience-accent" class="mt-2 block text-[#567600]">Không cần thêm giờ.</span>
                            </h1>
                            <p id="audience-sub" class="mt-7 max-w-2xl text-lg font-medium leading-8 text-[#526057] sm:text-xl">
                                Giảm 2–4 giờ soạn và chấm mỗi tuần, giữ học viên bằng kết quả thấy rõ.
                            </p>
                            <ul id="audience-bullets" class="mt-7 space-y-2.5">
                                <li class="flex items-center gap-3 font-semibold text-[#17231d]">
                                    <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#567600]"></i>
                                    <span>Nhắc học sinh ôn tự động theo FSRS</span>
                                </li>
                                <li class="flex items-center gap-3 font-semibold text-[#17231d]">
                                    <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#567600]"></i>
                                    <span>Thấy ngay từ/cấu trúc em đang yếu</span>
                                </li>
                                <li class="flex items-center gap-3 font-semibold text-[#17231d]">
                                    <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#567600]"></i>
                                    <span>Tạo lớp và mời học sinh trong vài phút</span>
                                </li>
                            </ul>
                            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                                <a id="audience-cta-primary"
                                   href="/auth?mode=signup&amp;role=teacher&amp;pilot=tutor"
                                   onclick="trackPilotCta(currentAudiencePlan, 'hero_' + currentAudience)"
                                   class="inline-flex items-center justify-center gap-2 rounded-2xl bg-[#17231d] px-7 py-4 font-black text-white shadow-[0_12px_0_#b9df4d] transition-transform hover:-translate-y-1">
                                    <span id="audience-cta-text">Tạo lớp miễn phí</span>
                                    <i data-lucide="arrow-right" class="size-5"></i>
                                </a>
                                <a href="#bang-gia"
                                   class="inline-flex items-center justify-center gap-2 rounded-2xl border border-[#17231d]/15 bg-white/70 px-7 py-4 font-black transition-colors hover:bg-white">
                                    Xem gói &amp; báo giá
                                </a>
                            </div>
                            <p class="mt-6 flex items-center gap-x-4 text-sm font-semibold text-[#657269]">
                                <span class="flex items-center gap-2">
                                    <i data-lucide="shield-check" class="size-4 text-[#567600]"></i> Không cần thẻ
                                </span>
                                <span>Hủy bất cứ lúc nào</span>
                                <span>Dữ liệu học sinh bảo mật</span>
                            </p>
                        </div>
                    </div>

                    <!-- Right Hero Dashboard Preview -->
                    <div class="relative mx-auto hidden w-full max-w-xl lg:block">
                        <div class="absolute -inset-5 rotate-3 rounded-[2rem] bg-[#d7ff64]"></div>
                        <div class="relative rounded-[2rem] border border-[#17231d]/10 bg-[#17231d] p-5 text-white shadow-2xl sm:p-7">
                            <div class="flex items-center justify-between border-b border-white/10 pb-5">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#9caaa1]">Lớp IELTS 7.0</p>
                                    <p class="mt-1 text-xl font-black">Tổng quan tuần này</p>
                                </div>
                                <div class="rounded-xl bg-[#d7ff64] p-2 text-[#17231d]">
                                    <i data-lucide="bar-chart-3" class="size-5"></i>
                                </div>
                            </div>
                            <div class="mt-5 grid grid-cols-3 gap-3">
                                <div class="rounded-2xl bg-white/[0.07] p-3">
                                    <p class="text-2xl font-black text-[#d7ff64]">24</p>
                                    <p class="mt-1 text-xs font-semibold text-[#9caaa1]">Học sinh</p>
                                </div>
                                <div class="rounded-2xl bg-white/[0.07] p-3">
                                    <p class="text-2xl font-black text-[#d7ff64]">86%</p>
                                    <p class="mt-1 text-xs font-semibold text-[#9caaa1]">Chính xác</p>
                                </div>
                                <div class="rounded-2xl bg-white/[0.07] p-3">
                                    <p class="text-2xl font-black text-[#d7ff64]">142</p>
                                    <p class="mt-1 text-xs font-semibold text-[#9caaa1]">Lượt ôn</p>
                                </div>
                            </div>
                            <div class="mt-5 rounded-2xl bg-white/[0.07] p-4">
                                <div class="mb-4 flex items-center justify-between">
                                    <p class="font-bold">Cần hỗ trợ hôm nay</p>
                                    <span class="rounded-full bg-[#ff8069]/15 px-2.5 py-1 text-xs font-bold text-[#ff9c89]">3 học sinh</span>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex items-center gap-3">
                                        <span class="flex size-9 items-center justify-center rounded-full bg-[#d7ff64]/15 text-xs font-black text-[#d7ff64]">M</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold">Minh Anh</p>
                                            <p class="truncate text-xs text-[#9caaa1]">Cụm động từ</p>
                                        </div>
                                        <span class="text-sm font-black text-[#ff9c89]">62%</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="flex size-9 items-center justify-center rounded-full bg-[#d7ff64]/15 text-xs font-black text-[#d7ff64]">G</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold">Gia Huy</p>
                                            <p class="truncate text-xs text-[#9caaa1]">Thì hoàn thành</p>
                                        </div>
                                        <span class="text-sm font-black text-[#ff9c89]">68%</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="flex size-9 items-center justify-center rounded-full bg-[#d7ff64]/15 text-xs font-black text-[#d7ff64]">T</span>
                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold">Thảo Vy</p>
                                            <p class="truncate text-xs text-[#9caaa1]">Từ học thuật</p>
                                        </div>
                                        <span class="text-sm font-black text-[#ff9c89]">71%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-5 flex items-center gap-3 rounded-2xl bg-[#d7ff64] p-4 text-[#17231d]">
                                <i data-lucide="zap" class="size-5 shrink-0"></i>
                                <p class="text-sm font-bold">AI đề xuất giao drill “phrasal verbs” cho 8 học sinh.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 3. Dải kết quả -->
            <section class="border-y border-[#17231d]/10 bg-white/70 px-4 py-10 sm:px-6">
                <div class="mx-auto grid max-w-7xl gap-7 md:grid-cols-3">
                    <div class="flex items-start gap-4">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#d7ff64]/60">
                            <i data-lucide="clock-3" class="size-5"></i>
                        </span>
                        <div>
                            <p class="text-xl font-black">Tiết kiệm 2–4 giờ/tuần</p>
                            <p class="mt-1 text-sm font-medium leading-6 text-[#657269]">soạn bài, chấm và nhắc ôn thủ công</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#d7ff64]/60">
                            <i data-lucide="target" class="size-5"></i>
                        </span>
                        <div>
                            <p class="text-xl font-black">1 dashboard</p>
                            <p class="mt-1 text-sm font-medium leading-6 text-[#657269]">nắm tiến độ, độ chính xác và từ khó của cả lớp</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <span class="flex size-11 shrink-0 items-center justify-center rounded-2xl bg-[#d7ff64]/60">
                            <i data-lucide="user-round-check" class="size-5"></i>
                        </span>
                        <div>
                            <p class="text-xl font-black">Nhắc ôn tự động</p>
                            <p class="mt-1 text-sm font-medium leading-6 text-[#657269]">mỗi học sinh có lịch ghi nhớ riêng theo FSRS</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 4. So sánh -->
            <section class="bg-[#17231d] px-4 py-24 text-white sm:px-6">
                <div class="mx-auto max-w-7xl">
                    <div class="grid gap-12 lg:grid-cols-2">
                        <div>
                            <p class="text-sm font-black uppercase tracking-[0.18em] text-[#d7ff64]">So sánh cách làm</p>
                            <h2 class="mt-4 text-4xl font-black tracking-[-0.04em] sm:text-5xl">Gom Sheet, Quizlet, Zalo vào một luồng.</h2>
                            <p class="mt-6 max-w-xl font-medium leading-8 text-[#aab5ae]">
                                LingoPro là lớp học tập (learning layer) — bổ sung cho phần mềm quản lý/điểm danh trung tâm đang dùng, không thay thế.
                            </p>
                        </div>
                        <div class="overflow-hidden rounded-3xl border border-white/10">
                            <div class="grid grid-cols-[1fr_80px_80px] border-b border-white/10 bg-white/[0.06] px-4 py-3 text-xs font-black uppercase tracking-wider text-[#aab5ae]">
                                <span>Khả năng</span>
                                <span>LingoPro</span>
                                <span class="truncate">Sheet...</span>
                            </div>
                            <div class="grid grid-cols-[1fr_80px_80px] items-center border-b border-white/10 px-4 py-4">
                                <span class="pr-3 text-sm font-semibold">Theo dõi tiến độ từng học sinh</span>
                                <span class="flex justify-center"><i data-lucide="check" class="size-5 text-[#d7ff64]"></i></span>
                                <span class="flex justify-center"><i data-lucide="x" class="size-5 text-[#77837b]"></i></span>
                            </div>
                            <div class="grid grid-cols-[1fr_80px_80px] items-center border-b border-white/10 px-4 py-4">
                                <span class="pr-3 text-sm font-semibold">Nhắc ôn cá nhân hóa tự động</span>
                                <span class="flex justify-center"><i data-lucide="check" class="size-5 text-[#d7ff64]"></i></span>
                                <span class="flex justify-center"><i data-lucide="x" class="size-5 text-[#77837b]"></i></span>
                            </div>
                            <div class="grid grid-cols-[1fr_80px_80px] items-center border-b border-white/10 px-4 py-4">
                                <span class="pr-3 text-sm font-semibold">Phát hiện từ khó và lỗi phổ biến</span>
                                <span class="flex justify-center"><i data-lucide="check" class="size-5 text-[#d7ff64]"></i></span>
                                <span class="flex justify-center"><i data-lucide="x" class="size-5 text-[#77837b]"></i></span>
                            </div>
                            <div class="grid grid-cols-[1fr_80px_80px] items-center border-b border-white/10 px-4 py-4">
                                <span class="pr-3 text-sm font-semibold">Giao bài theo vấn đề của lớp</span>
                                <span class="flex justify-center"><i data-lucide="check" class="size-5 text-[#d7ff64]"></i></span>
                                <span class="flex justify-center"><i data-lucide="x" class="size-5 text-[#77837b]"></i></span>
                            </div>
                            <div class="grid grid-cols-[1fr_80px_80px] items-center px-4 py-4">
                                <span class="pr-3 text-sm font-semibold">Một nơi cho từ vựng và ngữ pháp</span>
                                <span class="flex justify-center"><i data-lucide="check" class="size-5 text-[#d7ff64]"></i></span>
                                <span class="flex justify-center"><i data-lucide="x" class="size-5 text-[#77837b]"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- 5. Quy trình 3 bước -->
            <section id="giai-phap" class="px-4 py-24 sm:px-6">
                <div class="mx-auto max-w-4xl text-center">
                    <p class="text-sm font-black uppercase tracking-[0.18em] text-[#567600]">Quy trình đơn giản</p>
                    <h2 class="mt-4 text-4xl font-black tracking-[-0.04em] sm:text-5xl">Từ tạo lớp đến quyết định can thiệp trong ba bước.</h2>
                </div>
                <div class="mx-auto mt-12 grid max-w-7xl gap-5 lg:grid-cols-3">
                    <div class="group rounded-[1.75rem] border border-[#17231d]/10 bg-white p-7 transition-transform hover:-translate-y-1">
                        <div class="flex items-center justify-between">
                            <span class="text-5xl font-black tracking-[-0.08em] text-[#c8d0ca]">01</span>
                            <i data-lucide="arrow-right" class="size-5 transition-transform group-hover:translate-x-1"></i>
                        </div>
                        <h3 class="mt-10 text-xl font-black">Tạo lớp và mời học sinh</h3>
                        <p class="mt-3 text-sm font-medium leading-7 text-[#657269]">Gửi một mã lớp. Học sinh tham gia trong vài giây, không cần cài đặt phức tạp.</p>
                    </div>
                    <div class="group rounded-[1.75rem] border border-[#17231d]/10 bg-white p-7 transition-transform hover:-translate-y-1">
                        <div class="flex items-center justify-between">
                            <span class="text-5xl font-black tracking-[-0.08em] text-[#c8d0ca]">02</span>
                            <i data-lucide="arrow-right" class="size-5 transition-transform group-hover:translate-x-1"></i>
                        </div>
