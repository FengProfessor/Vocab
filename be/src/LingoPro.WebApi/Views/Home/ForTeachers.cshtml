    <!-- Client-side Interactive Scripts matching TeacherPilotClient.tsx -->
    <script>
        if (window.lucide) {
            window.lucide.createIcons();
        }

        const audienceContent = {
            tutor: {
                badge: 'Cho gia sư 1:1 & nhóm nhỏ',
                lead: 'Dạy sát từng em.',
                accent: 'Không cần thêm giờ.',
                sub: 'Giảm 2–4 giờ soạn và chấm mỗi tuần, giữ học viên bằng kết quả thấy rõ.',
                bullets: [
                    'Nhắc học sinh ôn tự động theo FSRS',
                    'Thấy ngay từ/cấu trúc em đang yếu',
                    'Tạo lớp và mời học sinh trong vài phút'
                ],
                ctaPrimary: {
                    plan: 'tutor',
                    text: 'Tạo lớp miễn phí',
                    href: '/auth?mode=signup&role=teacher&pilot=tutor'
                }
            },
            teacher: {
                badge: 'Cho giáo viên nhiều lớp',
                lead: 'Biết ai cần giúp,',
                accent: 'trước khi điểm rớt.',
                sub: 'Một dashboard cho mọi lớp — can thiệp đúng người, đúng lúc.',
                bullets: [
                    'Dashboard tiến độ cả lớp theo thời gian thực',
                    'Phát hiện học sinh hụt nhịp sớm',
                    'Giao drill đúng lỗi thay vì đại trà'
                ],
                ctaPrimary: {
                    plan: 'teacher_pro',
                    text: 'Tạo lớp miễn phí',
                    href: '/auth?mode=signup&role=teacher&pilot=teacher_pro'
                }
            },
            center: {
                badge: 'Cho trung tâm & chuỗi',
                lead: 'Chuẩn hóa chất lượng dạy',
                accent: 'trên mọi lớp.',
                sub: 'Theo dõi nhiều giáo viên, báo cáo cho phụ huynh, onboarding đội ngũ nhanh.',
                bullets: [
                    'Bổ sung learning layer cho phần mềm CRM sẵn có',
                    'Báo cáo tiến độ gửi phụ huynh',
                    'Onboarding & hỗ trợ triển khai riêng'
                ],
                ctaPrimary: {
                    plan: 'center',
                    text: 'Đặt lịch demo',
                    href: '#tu-van-trung-tam'
                }
            }
        };

        let currentAudience = 'tutor';
        let currentAudiencePlan = 'tutor';

        function trackPilotCta(plan, placement) {
            try {
                const source = new URLSearchParams(window.location.search).get('utm_source') || 'direct';
                sessionStorage.setItem('teacher_pilot_source', source);
                sessionStorage.setItem('teacher_pilot_plan', plan);
            } catch (_) {}
        }

        function setActiveAudience(audience) {
            const content = audienceContent[audience];
            if (!content) return;
            currentAudience = audience;
            currentAudiencePlan = content.ctaPrimary.plan;

            document.querySelectorAll('.audience-tab-btn').forEach(btn => {
                if (btn.getAttribute('data-audience-tab') === audience) {
                    btn.className = 'audience-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors bg-[#17231d] text-[#d7ff64] cursor-pointer';
                } else {
                    btn.className = 'audience-tab-btn w-1/3 rounded-full py-2.5 text-sm font-bold transition-colors border border-transparent bg-transparent text-[#526057] hover:bg-white cursor-pointer';
                }
            });

            const badgeEl = document.getElementById('audience-badge');
            const leadEl = document.getElementById('audience-lead');
            const accentEl = document.getElementById('audience-accent');
            const subEl = document.getElementById('audience-sub');
            const bulletsEl = document.getElementById('audience-bullets');
            const ctaEl = document.getElementById('audience-cta-primary');
            const ctaTextEl = document.getElementById('audience-cta-text');

            if (badgeEl) badgeEl.textContent = content.badge;
            if (leadEl) leadEl.textContent = content.lead;
            if (accentEl) accentEl.textContent = content.accent;
            if (subEl) subEl.textContent = content.sub;
            if (ctaEl) ctaEl.setAttribute('href', content.ctaPrimary.href);
            if (ctaTextEl) ctaTextEl.textContent = content.ctaPrimary.text;

            if (bulletsEl) {
                bulletsEl.innerHTML = content.bullets.map(b => `
                    <li class="flex items-center gap-3 font-semibold text-[#17231d]">
                        <i data-lucide="check-circle-2" class="size-5 shrink-0 text-[#567600]"></i>
                        <span>${b}</span>
                    </li>
                `).join('');
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }
        }

        let openFaqIndex = null;
        function toggleFaq(index) {
            const nextOpen = openFaqIndex === index ? null : index;
            for (let i = 0; i < 9; i++) {
                const ans = document.getElementById('faq-answer-' + i);
                const icon = document.getElementById('faq-icon-' + i);
                if (i === nextOpen) {
                    ans?.classList.remove('hidden');
                    icon?.classList.add('rotate-180');
                } else {
                    ans?.classList.add('hidden');
                    icon?.classList.remove('rotate-180');
                }
            }
            openFaqIndex = nextOpen;
        }

        async function submitCenterLeadForm(event) {
            event.preventDefault();
            const contactName = (document.getElementById('lead-contact-name')?.value || '').trim();
            const organization = (document.getElementById('lead-organization')?.value || '').trim();
            const email = (document.getElementById('lead-email')?.value || '').trim();
            const phone = (document.getElementById('lead-phone')?.value || '').trim();
            const teacherCount = Number(document.getElementById('lead-teacher-count')?.value || 10);
            const studentCount = Number(document.getElementById('lead-student-count')?.value || 200);
            const message = (document.getElementById('lead-message')?.value || '').trim();
            const website = document.getElementById('lead-website')?.value || '';

            const errorEl = document.getElementById('center-lead-error');
            const submitBtn = document.getElementById('center-lead-submit');

            if (errorEl) {
                errorEl.classList.add('hidden');
                errorEl.textContent = '';
            }
            if (submitBtn) submitBtn.disabled = true;

            try {
                const res = await fetch('/api/pilot/leads', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contactName,
                        email,
                        phone,
                        organization,
                        teacherCount,
                        studentCount,
                        message,
                        website,
                        source: 'teacher_landing_center_form'
                    })
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Không thể gửi yêu cầu.');
                }

                const formEl = document.getElementById('center-lead-form');
                const successEl = document.getElementById('center-lead-success');
                formEl?.classList.add('hidden');
                if (successEl) {
                    successEl.classList.remove('hidden');
                    successEl.classList.add('flex');
                }
            } catch (err) {
                if (errorEl) {
                    errorEl.textContent = err instanceof Error ? err.message : 'Không thể gửi yêu cầu.';
                    errorEl.classList.remove('hidden');
                }
            } finally {
                if (submitBtn) submitBtn.disabled = false;
            }
        }
    </script>
</body>
</html>
