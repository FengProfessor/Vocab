          "embedUrl": "@siteUrl/#video-demo",
          "uploadDate": "2026-06-01",
          "inLanguage": "vi"
        },
        {
          "@@type": "VideoObject",
          "name": "Demo tra từ 1 chạm trên web — LingoPro Extension",
          "description": "Tra từ ngay trên trang đang đọc bằng Chrome Extension LingoPro.",
          "thumbnailUrl": "@siteUrl/images/extension-lookup-poster.webp",
          "contentUrl": "@siteUrl/extension-lookup.mp4?v=2",
          "embedUrl": "@siteUrl/#video-demo",
          "uploadDate": "2026-06-01",
          "inLanguage": "vi"
        }
      ]
    }
    </script>

    <style>
        :root {
            --font-inter: 'Inter', 'Be Vietnam Pro', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; font-family: var(--font-inter); }
        body {
            margin: 0;
            min-height: 100dvh;
            background-color: #f6efe6;
            color: #241710;
            font-family: var(--font-inter);
            -webkit-font-smoothing: antialiased;
        }
        a { color: inherit; text-decoration: none; }
        details > summary { list-style: none; }
        details > summary::-webkit-details-marker { display: none; }
        details[open] .faq-plus { transform: rotate(45deg); }
        @@keyframes bounceSlow {
            0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8,0,1,1); }
            50% { transform: translateY(0); animation-timing-function: cubic-bezier(0,0,0.2,1); }
        }
        .animate-bounce-icon { animation: bounceSlow 1s infinite; }
        @@keyframes spinIcon {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-icon { animation: spinIcon 1s linear infinite; }
    </style>
</head>
<body class="min-h-dvh bg-[#f6efe6] text-[#241710] antialiased">
    <!-- AuthRedirectGate: giống src/app/_components/AuthRedirectGate.tsx -->
    <script>
        (function () {
            try {
                var params = new URLSearchParams(window.location.search);
                if (params.get('stay') === '1') return;
                var cached = localStorage.getItem('lingopro_last_profile_v1');
                if (cached) {
                    var parsed = JSON.parse(cached);
                    if (parsed && parsed.id) {
                        window.location.replace('/app/journey');
                    }
                }
            } catch (_) {}
        })();
    </script>

