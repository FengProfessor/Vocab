    <title>@pageTitle</title>
    <meta name="description" content="@metaDesc" />
    <meta name="keywords" content="học từ vựng, học từ vựng tiếng Anh, tra từ tiếng Anh, flashcard FSRS, spaced repetition, ôn từ vựng, từ vựng TOEIC, từ vựng IELTS, từ vựng THPT, Anki tiếng Việt, LingoPro" />
