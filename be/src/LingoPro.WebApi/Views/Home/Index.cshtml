    <!-- OpenGraph / Facebook / Zalo SEO Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="LingoPro" />
    <meta property="og:title" content="LingoPro — Học từ vựng, tra từ 1 chạm, nhớ lâu hơn" />
    <meta property="og:description" content="Tra từ trên web · flashcard FSRS · lộ trình sẵn cho người Việt. Bắt đầu miễn phí." />
    <meta property="og:url" content="@siteUrl" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="LingoPro — Học từ vựng tiếng Anh nhớ lâu hơn" />
    <meta name="twitter:description" content="Tra từ 1 chạm, ôn đúng lúc bằng FSRS. Miễn phí bắt đầu." />

    <!-- Google Fonts: Inter & Be Vietnam Pro -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Tailwind CSS v4 Browser Runtime -->
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@@4"></script>

    <!-- Structured Data JSON-LD matching src/app/page.tsx -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@graph": [
        {
          "@@type": "SoftwareApplication",
          "name": "LingoPro",
          "applicationCategory": "EducationalApplication",
          "operatingSystem": "Web, Windows",
          "url": "@siteUrl",
          "description": "App học từ vựng tiếng Anh: tra từ 1 chạm, flashcard FSRS, lộ trình THPT · TOEIC · IELTS cho người Việt.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "VND",
            "description": "Gói Free — nâng Pro tùy chọn"
          },
          "inLanguage": "vi"
        },
        {
          "@@type": "WebSite",
          "name": "LingoPro",
          "url": "@siteUrl",
          "inLanguage": "vi-VN",
          "description": "Học từ vựng tiếng Anh với tra từ 1 chạm và flashcard FSRS."
        },
        {
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "LingoPro học từ vựng bằng cách nào?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Tra từ trên web, lưu vào kho, rồi ôn lại theo lịch FSRS (spaced repetition) — mỗi chặng khoảng 5–8 phút."
              }
            },
            {
              "@@type": "Question",
              "name": "Có miễn phí không?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Có gói Free: flashcard FSRS, lưu 200 từ mới/tháng, lộ trình sẵn và tra từ AI 5 lượt/ngày. Nâng Pro khi cần không giới hạn."
              }
            },
            {
              "@@type": "Question",
              "name": "LingoPro khác Anki ở điểm nào?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "LingoPro có sẵn lộ trình Việt hóa, tra–lưu 1 chạm và nhắc ôn. Anki mạnh hơn nếu bạn thích tự dựng toàn bộ hệ thống."
              }
            },
            {
              "@@type": "Question",
              "name": "Có cần cài app không?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Học ngay trên web. Có thêm app Desktop và Chrome Extension để tra từ khi đọc trang."
              }
            }
          ]
        },
        {
          "@@type": "VideoObject",
          "name": "Demo LingoPro — tra từ và lưu vào kho",
