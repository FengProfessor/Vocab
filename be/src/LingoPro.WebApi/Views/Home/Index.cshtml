@model LingoPro.Application.Features.Seo.LandingPageSeoDto
@{
    Layout = null;
    var siteUrl = string.IsNullOrWhiteSpace(Model?.CanonicalUrl) ? "https://lingopro.online" : Model.CanonicalUrl.TrimEnd('/');
    var pageTitle = string.IsNullOrWhiteSpace(Model?.PageTitle)
        ? "LingoPro — Học từ vựng tiếng Anh, tra từ 1 chạm, nhớ lâu với FSRS"
        : Model.PageTitle;
    var metaDesc = string.IsNullOrWhiteSpace(Model?.MetaDescription)
        ? "App học từ vựng cho người Việt: tra từ trên web, flashcard FSRS, lộ trình THPT · TOEIC · IELTS. Miễn phí bắt đầu — 5–8 phút/ngày."
        : Model.MetaDescription;
    var vocabPacksText = (Model?.TotalVocabularyPacks ?? 660) >= 660 ? $"{Model?.TotalVocabularyPacks ?? 660}+" : "660+";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
