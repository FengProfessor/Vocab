{
  "slug": "past-continuous",
  "title": "Past Continuous",
  "title_vi": "Thì Quá khứ tiếp diễn",
  "level": "beginner",
  "order": 21,
  "sections": {
    "definition": "**Thì Quá khứ tiếp diễn** (Past Continuous) diễn tả hành động **đang diễn ra** tại một thời điểm cụ thể trong quá khứ. Nó thường được sử dụng để mô tả một hành động **đang xảy ra** khi một hành động khác **xảy ra**.",
    "usage": [
      {
        "icon": "🕐",
        "label": "Hành động đang diễn ra tại một thời điểm xác định trong quá khứ",
        "en": "I was studying English at 8 p.m. last night.",
        "vi": "Tối qua lúc 8 giờ tôi đang học tiếng Anh."
      },
      {
        "icon": "⚡",
        "label": "Hành động đang diễn ra thì bị một hành động khác xen vào (quá khứ đơn)",
        "en": "They were talking on the phone when I arrived.",
        "vi": "Họ đang nói chuyện điện thoại thì tôi đến."
      },
      {
        "icon": "🔀",
        "label": "Hai hành động diễn ra song song trong quá khứ (thường với while)",
        "en": "She was cooking dinner while I was watching TV.",
        "vi": "Cô ấy đang nấu bữa tối trong khi tôi đang xem TV."
      },
      {
        "icon": "🎬",
        "label": "Miêu tả bối cảnh, khung cảnh trong câu chuyện quá khứ",
        "en": "The sun was shining and birds were singing when we set off.",
        "vi": "Mặt trời đang chiếu sáng và chim đang hót khi chúng tôi khởi hành."
      }
    ],
    "formula": {
      "rows": [
        {
          "form": "(+) Khẳng định",
          "base": "S + was/were + V-ing"
        },
        {
          "form": "(-) Phủ định",
          "base": "S + was/were + not + V-ing"
        },
        {
          "form": "(?) Nghi vấn",
          "base": "Was/Were + S + V-ing?"
        }
      ],
      "note": "Dạng **was** được sử dụng cho **I**, **he**, **she**, **it**, trong khi **were** được sử dụng cho **you**, **we**, **they**."
    },
    "rules": [
      {
        "case": "Động từ thường",
        "rule": "thêm -ing",
        "example": "walk → walking"
      },
      {
        "case": "Động từ tận cùng -e",
        "rule": "bỏ -e và thêm -ing",
        "example": "love → loving"
      },
      {
        "case": "Động từ có một âm tiết và tận cùng -y",
        "rule": "thêm -ing",
        "example": "try → trying"
      },
      {
        "case": "Động từ có hai âm tiết và tận cùng -y",
        "rule": "thêm -ing hoặc thay -y bằng -i và thêm -ng",
        "example": "carry → carrying hoặc study → studying"
      }
    ],
