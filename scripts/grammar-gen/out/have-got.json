{
  "slug": "have-got",
  "title": "Have got / Has got",
  "title_vi": "Cấu trúc have got / has got",
  "level": "beginner",
  "order": 2,
  "sections": {
    "definition": "**Have got / has got** có nghĩa là **có, sở hữu**. Cấu trúc này rất phổ biến trong tiếng Anh Anh và thường dùng để nói về đồ vật, gia đình, đặc điểm cơ thể hoặc tình trạng hiện tại. **Have got** đi với I/you/we/they; **has got** đi với he/she/it.",
    "usage": [
      {
        "icon": "🎒",
        "label": "Nói về đồ vật mình sở hữu",
        "en": "I have got a new bag.",
        "vi": "Tôi có một chiếc túi mới."
      },
      {
        "icon": "👨‍👩‍👧",
        "label": "Nói về gia đình và các mối quan hệ",
        "en": "She has got two brothers.",
        "vi": "Cô ấy có hai anh/em trai."
      },
      {
        "icon": "👀",
        "label": "Miêu tả đặc điểm cơ thể",
        "en": "He has got brown eyes.",
        "vi": "Cậu ấy có đôi mắt nâu."
      },
      {
        "icon": "🤕",
        "label": "Nói tình trạng hoặc vấn đề hiện tại",
        "en": "I have got a headache.",
        "vi": "Tôi bị đau đầu."
      }
    ],
    "formula": {
      "rows": [
        {
          "form": "(+) Khẳng định",
          "base": "I/You/We/They + have got",
          "third": "He/She/It + has got"
        },
        {
          "form": "(−) Phủ định",
          "base": "I/You/We/They + haven't got",
          "third": "He/She/It + hasn't got"
        },
        {
          "form": "(?) Nghi vấn",
          "base": "Have + I/you/we/they + got...?",
          "third": "Has + he/she/it + got...?"
        }
      ],
      "note": "Trong câu hỏi và phủ định, have/has hoạt động như trợ động từ. Không dùng do/does với cấu trúc have got."
    },
    "rules": [
      {
        "case": "I, You, We, They",
        "rule": "dùng have got",
        "example": "We have got a car."
      },
      {
        "case": "He, She, It hoặc một người/vật",
        "rule": "dùng has got",
        "example": "Mai has got a bicycle."
      },
      {
        "case": "Dạng phủ định",
        "rule": "haven't got / hasn't got",
        "example": "They haven't got a map. He hasn't got a map."
      },
      {
        "case": "Dạng rút gọn khẳng định",
        "rule": "'ve got / 's got",
        "example": "I've got a pen. She's got a pen."
      }
    ],
