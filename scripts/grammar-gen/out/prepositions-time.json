{
  "slug": "prepositions-time",
  "title": "Prepositions of Time (in/on/at)",
  "title_vi": "Giới từ chỉ thời gian (in/on/at)",
  "level": "beginner",
  "order": 16,
  "sections": {
    "definition": "**Giới từ chỉ thời gian** (*in, on, at*) được sử dụng để xác định thời điểm, ngày tháng, hoặc khoảng thời gian diễn ra một sự kiện. Thông thường, *in* dùng cho tháng, năm, mùa; *on* dùng cho ngày cụ thể; và *at* dùng cho giờ hoặc thời điểm chính xác.",
    "usage": [
      {
        "icon": "📆",
        "label": "Tháng, năm, thế kỷ",
        "en": "I was born in June.",
        "vi": "Tôi sinh ra vào tháng sáu."
      },
      {
        "icon": "🕰️",
        "label": "Giờ, thời điểm cụ thể",
        "en": "The meeting starts at 5 o'clock.",
        "vi": "Cuộc họp bắt đầu vào lúc 5 giờ."
      },
      {
        "icon": "📅",
        "label": "Ngày trong tuần, ngày lễ",
        "en": "I have a meeting on Monday.",
        "vi": "Tôi có một cuộc họp vào thứ hai."
      },
      {
        "icon": "🌞",
        "label": "Mùa",
        "en": "I love swimming in summer.",
        "vi": "Tôi yêu thích bơi lội vào mùa hè."
      }
    ],
    "formula": {
