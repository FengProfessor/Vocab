{
  "slug": "personal-pronouns",
  "title": "Personal Pronouns",
  "title_vi": "Đại từ nhân xưng",
  "level": "beginner",
  "order": 11,
  "sections": {
    "definition": "**Đại từ nhân xưng** (Personal Pronouns) như *I, you, he, she, it, we, they* dùng để thay thế cho danh từ chỉ người hoặc vật đã được đề cập hoặc người nghe đã biết, giúp tránh lặp lại. Chúng thay đổi hình thức tùy thuộc vào việc chúng làm chủ ngữ hay tân ngữ trong câu.",
    "usage": [
      {
        "icon": "👤",
        "label": "Làm chủ ngữ của câu",
        "en": "She works here.",
        "vi": "Cô ấy làm việc ở đây."
      },
      {
        "icon": "🎯",
        "label": "Làm tân ngữ của động từ",
        "en": "I called him yesterday.",
        "vi": "Tôi đã gọi cho anh ấy hôm qua."
      },
      {
        "icon": "🔗",
        "label": "Đứng sau giới từ",
        "en": "This gift is for them.",
        "vi": "Món quà này dành cho họ."
      },
      {
        "icon": "🔁",
        "label": "Thay danh từ để tránh lặp",
        "en": "Mai has a cat. It is white.",
        "vi": "Mai có một con mèo. Nó màu trắng."
      }
    ],
    "formula": {
      "rows": [
        {
          "form": "Chủ ngữ",
          "structure": "I / you / he / she / it / we / they + V",
          "example": "They know me."
        },
        {
          "form": "Tân ngữ",
          "structure": "V + me / you / him / her / it / us / them",
          "example": "I know them."
        },
        {
          "form": "Sau giới từ",
          "structure": "preposition + object pronoun",
          "example": "with her, for us"
        }
      ],
      "note": "Đọc cấu trúc cùng ví dụ và luôn kiểm tra vai trò, số lượng hoặc dạng động từ theo từng trường hợp."
    },
    "rules": [
      {
        "case": "Nam / nữ",
        "rule": "he-him / she-her",
        "example": "He called her."
      },
      {
        "case": "Vật hoặc con vật",
        "rule": "it ở cả chủ ngữ và tân ngữ",
        "example": "It is new. I bought it."
      },
      {
        "case": "Người nói + người khác",
        "rule": "we-us",
        "example": "We invited them."
      },
      {
        "case": "Nhiều người/vật khác",
        "rule": "they-them",
        "example": "They helped us."
      }
    ],
    "signals": [
      "trước động từ chính",
      "sau động từ",
      "sau for/to/with/about",
      "thay danh từ đã nhắc"
    ],
