{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/image": ["./src/shims/next-image.tsx"],
      "next/dynamic": ["./src/shims/next-dynamic.tsx"],
      "next/font/google": ["./src/shims/next-font-google.ts"],
      "next/server": ["./src/shims/next-server.ts"],
      "next/og": ["./src/shims/next-og.tsx"],
      "next": ["./src/shims/next-types.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "src/data"
  ]
}
