        {
          "id": "631971e2f2fe240a4043ae51",
          "questionText": "The word “confirm” in line 15 of the notice is closest in meaning to:",
          "image": "",
          "sound": "",
          "options": [
            "(A) certify",
            "(B) refute",
            "(C) purchase",
            "(D) admit"
          ],
          "correctOptions": [
            "(A) certify"
