{
  "name": "lingopro-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:staging": "tsc --noEmit && vite build --mode staging",
    "dev:staging": "vite --mode staging",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "gen:api": "node scripts/gen-api-types.mjs",
    "lint": "eslint src",
    "test:unit": "vitest run",
    "check": "npm run typecheck && npm run typecheck:e2e && npm run lint && npm run test:unit",
    "test": "npx tsx tests/qa/run-all-qa-suites.ts",
    "test:qa": "npx tsx tests/qa/run-all-qa-suites.ts",
    "test:offline": "npx tsx tests/offline/offline-study-engine.test.ts",
    "test:toeic": "npx tsx tests/toeic/run-all-toeic-tests.ts",
    "test:vstep": "npx tsx tests/vstep/run-all-vstep-tests.ts",
    "test:vnu": "node tests/vnu-bac-3/scoring.test.mjs && node tests/vnu-bac-3/security.test.mjs",
    "test:grammar": "npx tsx tests/grammar/run-all-grammar-tests.ts",
    "test:listening": "npx tsx tests/listening/run-all-listening-tests.ts",
    "test:speaking": "npx tsx tests/speaking/run-all-speaking-tests.ts",
    "test:pronunciation": "npx tsx tests/pronunciation/run-all-pronunciation-tests.ts",
    "test:journey": "npx tsx tests/journey/run-all-journey-tests.ts",
    "test:e2e:smoke": "node tests/e2e/application-smoke.test.mjs",
    "test:e2e": "playwright test",
    "open-vocab:stage": "npx tsx scripts/import-open-vocab-sources.ts",
    "open-vocab:validate": "npx tsx scripts/validate-open-vocab-sources.ts",
    "open-vocab:apply": "npx tsx scripts/import-open-vocab-sources.ts --apply",
    "vocab:ipa": "npx tsx scripts/backfill-missing-ipa.ts --target=words",
    "vocab:ipa:apply": "npx tsx scripts/backfill-missing-ipa.ts --target=words --apply",
    "vocab:ipa:gd": "npx tsx scripts/backfill-missing-ipa.ts --target=gd --limit=1000 --apply",
    "video:toeic": "node scripts/render-toeic-tiktok.mjs",
    "video:toeic:100": "node scripts/render-toeic-tiktok.mjs --tracker=data/tiktok/toeic-listening-100.json --outDir=out/tiktok-toeic-100",
    "video:toeic:status": "node scripts/toeic-tiktok-tracker.mjs status",
    "force-onboarding": "node scripts/force-onboarding.js",
    "flow:prompts": "npx tsx scripts/flow/generate-roadmap-flow.ts",
    "flow:gen": "python -u scripts/flow/run-flow-headless.py",
    "flow:ingest": "npx tsx scripts/flow/ingest-flow-batch.ts",
    "flow:auth:export": "python scripts/flow/export-auth-secret.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@remotion/player": "^4.0.524",
    "@supabase/supabase-js": "^2.99.0",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.13.0",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.7",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.376.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.524",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^5.4.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.7"
  }
}
